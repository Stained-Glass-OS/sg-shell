#include <windows.h>

1 ICON "sg-documents.ico"
1 24 "../launcher/office.manifest"

VS_VERSION_INFO VERSIONINFO
FILEVERSION 1,0,0,0
PRODUCTVERSION 1,0,0,0
FILEOS VOS_NT_WINDOWS32
FILETYPE VFT_APP
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName", "Stained Glass OS"
            VALUE "FileDescription", "Get SG Office"
            VALUE "FileVersion", "1.0"
            VALUE "ProductName", "SG Office"
            VALUE "ProductVersion", "1.0"
            VALUE "LegalCopyright", "Stained Glass OS contributors, AGPL-3.0-or-later"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
