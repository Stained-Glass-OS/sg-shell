Windows Registry Editor Version 5.00


; Stained Glass OS -- SG Office: its programs and file types (office/gen-reg.py).
; Which program a type opens with by default is 89-sg-office-types.reg.

[HKEY_LOCAL_MACHINE\Software\Microsoft\Windows\CurrentVersion\App Paths\sg-documents.exe]
@="Z:\\usr\\libexec\\stained-glass\\shell\\sg-documents64.exe"

[HKEY_LOCAL_MACHINE\Software\Classes\Applications\sg-documents64.exe]
"FriendlyAppName"="SG Office Documents"

[HKEY_LOCAL_MACHINE\Software\Classes\Applications\sg-documents64.exe\shell\open\command]
@="\"Z:\\usr\\libexec\\stained-glass\\shell\\sg-documents64.exe\" \"%1\""

[HKEY_LOCAL_MACHINE\Software\Classes\Applications\sg-documents64.exe\SupportedTypes]
".docx"=""
".docm"=""
".doc"=""
".dotx"=""
".dotm"=""
".dot"=""
".odt"=""
".ott"=""

[HKEY_LOCAL_MACHINE\Software\Microsoft\Windows\CurrentVersion\App Paths\sg-spreadsheets.exe]
