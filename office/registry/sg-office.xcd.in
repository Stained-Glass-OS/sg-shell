<?xml version="1.0" encoding="UTF-8"?>
<!--
  SG Office: the suite's defaults, read by LibreOffice as a layer of its own
  above its shipped configuration (installed as
  /usr/lib/libreoffice/share/registry/sg-office.xcd). Defaults only, none
  finalized: every one stays the user's to change in Tools > Options, and a
  user's choice (registrymodifications.xcu) wins over it.

  Get SG Office (office/setup) installs it into LibreOffice's share/registry,
  with file://@TEMPLATEDIR@ replaced by the URL of the templates it copies.

  Copyright (C) 2026 Stained Glass OS contributors
  SPDX-License-Identifier: AGPL-3.0-or-later
-->
<oor:data xmlns:xs="http://www.w3.org/2001/XMLSchema" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:oor="http://openoffice.org/2001/registry">
 <!-- read after LibreOffice's own, so these values win over theirs -->
 <dependency file="main"/><dependency file="writer"/><dependency file="calc"/><dependency file="impress"/>

 <!-- The product: our name in titles and dialogs; the three programs by what they make. -->
 <oor:component-data oor:name="Setup" oor:package="org.openoffice">
  <node oor:name="Product">
   <prop oor:name="ooName"><value>SG Office</value></prop>
   <!-- no "what's new", "get involved" or "donate" bars over a new user's first document -->
   <prop oor:name="ooSetupLastVersion"><value>25.2</value></prop>
   <prop oor:name="LastTimeGetInvolvedShown"><value>4102444800</value></prop>
   <prop oor:name="LastTimeDonateShown"><value>4102444800</value></prop>
  </node>
  <node oor:name="Office">
   <node oor:name="Factories">
    <!-- Save in Microsoft's formats, starting from our templates. -->
    <node oor:name="com.sun.star.text.TextDocument">
     <prop oor:name="ooSetupFactoryDefaultFilter"><value>MS Word 2007 XML</value></prop>
     <prop oor:name="ooSetupFactoryTemplateFile"><value>file://@TEMPLATEDIR@/normal.ott</value></prop>
     <prop oor:name="ooSetupFactoryUIName"><value>Documents</value></prop>
    </node>
    <node oor:name="com.sun.star.sheet.SpreadsheetDocument">
     <prop oor:name="ooSetupFactoryDefaultFilter"><value>Calc MS Excel 2007 XML</value></prop>
     <prop oor:name="ooSetupFactoryTemplateFile"><value>file://@TEMPLATEDIR@/book.ots</value></prop>
     <prop oor:name="ooSetupFactoryUIName"><value>Spreadsheets</value></prop>
    </node>
    <node oor:name="com.sun.star.presentation.PresentationDocument">
     <prop oor:name="ooSetupFactoryDefaultFilter"><value>Impress MS PowerPoint 2007 XML</value></prop>
     <prop oor:name="ooSetupFactoryTemplateFile"><value>file://@TEMPLATEDIR@/blank.otp</value></prop>
     <prop oor:name="ooSetupFactoryUIName"><value>Presentations</value></prop>
    </node>
   </node>
  </node>
 </oor:component-data>

 <oor:component-data oor:name="Common" oor:package="org.openoffice.Office">
  <node oor:name="Save">
   <node oor:name="Document">
    <!-- .docx/.xlsx/.pptx are the default formats: no "keep current format?" prompt -->
    <prop oor:name="WarnAlienFormat"><value>false</value></prop>
   </node>
  </node>
  <node oor:name="Security">
   <node oor:name="Scripting">
    <!-- macros in documents: asked about when a document has them (as Excel's
         "Enable content" bar), not silently disabled -->
    <prop oor:name="MacroSecurityLevel"><value>1</value></prop>
   </node>
  </node>
  <node oor:name="Misc">
   <prop oor:name="ShowTipOfTheDay"><value>false</value></prop>
   <prop oor:name="FirstRun"><value>false</value></prop>
   <!-- Colibre: the icon set drawn in the style of the shell's programs -->
   <prop oor:name="SymbolStyle"><value>colibre</value></prop>
   <!-- the colours follow the desktop: the launcher passes the shell's light or dark mode -->
   <prop oor:name="ApplicationAppearance"><value>0</value></prop>
  </node>
 </oor:component-data>

 <!-- The tabbed ribbon (File, Home, Insert, Layout, References, Review, View ...), not toolbars. -->
 <oor:component-data oor:name="ToolbarMode" oor:package="org.openoffice.Office.UI">
  <prop oor:name="ActiveWriter"><value>notebookbar.ui</value></prop>
  <!-- spreadsheets: SG Office's ribbon, whose Home tab is laid out as Excel's
       (office/notebookbar/gen-calc.py) -->
  <prop oor:name="ActiveCalc"><value>notebookbar_sgoffice.ui</value></prop>
  <prop oor:name="ActiveImpress"><value>notebookbar.ui</value></prop>
  <node oor:name="Applications">
   <node oor:name="Writer"><prop oor:name="Active"><value>notebookbar.ui</value></prop></node>
   <node oor:name="Calc">
    <prop oor:name="Active"><value>notebookbar_sgoffice.ui</value></prop>
    <node oor:name="Modes">
     <node oor:name="SGOffice" oor:op="replace">
      <prop oor:name="Label"><value xml:lang="en-US">Ribbon (SG Office)</value></prop>
      <prop oor:name="CommandArg"><value>notebookbar_sgoffice.ui</value></prop>
      <prop oor:name="MenuPosition"><value>3</value></prop>
      <prop oor:name="HasNotebookbar"><value>true</value></prop>
      <prop oor:name="IsExperimental"><value>false</value></prop>
      <prop oor:name="Toolbars"><value/></prop>
      <prop oor:name="UserToolbars"><value/></prop>
      <prop oor:name="Sidebar"><value>Arrow</value></prop>
     </node>
    </node>
   </node>
   <node oor:name="Impress"><prop oor:name="Active"><value>notebookbar.ui</value></prop></node>
  </node>
 </oor:component-data>

 <!-- The spreadsheet ribbon's Home tab names its buttons as Excel's: a
      ribbon button shows its command's Label; menus keep LibreOffice's
      wording (PopupLabel, copied from LibreOffice's own). -->
 <oor:component-data oor:name="CalcCommands" oor:package="org.openoffice.Office.UI">
  <node oor:name="UserInterface">
   <node oor:name="Commands">
     <node oor:name=".uno:InsertCalcTable" oor:op="fuse"><prop oor:name="Label" oor:type="xs:string"><value xml:lang="en-US">Format as Table</value></prop><prop oor:name="PopupLabel" oor:type="xs:string"><value xml:lang="en-US">~Table...</value></prop></node>
     <node oor:name=".uno:ToggleMergeCells" oor:op="fuse"><prop oor:name="Label" oor:type="xs:string"><value xml:lang="en-US">Merge &amp; Center</value></prop><prop oor:name="PopupLabel" oor:type="xs:string"><value xml:lang="en-US">M~erge and Center Cells</value></prop></node>
     <node oor:name=".uno:ConditionalFormatMenu" oor:op="fuse"><prop oor:name="Label" oor:type="xs:string"><value xml:lang="en-US">Conditional Formatting</value></prop><prop oor:name="PopupLabel" oor:type="xs:string"><value xml:lang="en-US">C~onditional</value></prop></node>
     <node oor:name=".uno:AutoSum" oor:op="fuse"><prop oor:name="Label" oor:type="xs:string"><value xml:lang="en-US">AutoSum</value></prop><prop oor:name="PopupLabel" oor:type="xs:string"><value xml:lang="en-US">Sum</value></prop></node>
     <node oor:name=".uno:FillDown" oor:op="fuse"><prop oor:name="Label" oor:type="xs:string"><value xml:lang="en-US">Fill</value></prop><prop oor:name="PopupLabel" oor:type="xs:string"><value xml:lang="en-US">Fill ~Down</value></prop></node>
     <node oor:name=".uno:Delete" oor:op="fuse"><prop oor:name="Label" oor:type="xs:string"><value xml:lang="en-US">Clear</value></prop><prop oor:name="PopupLabel" oor:type="xs:string"><value xml:lang="en-US">Cle~ar Cells...</value></prop></node>
     <node oor:name=".uno:DataFilterAutoFilter" oor:op="fuse"><prop oor:name="Label" oor:type="xs:string"><value xml:lang="en-US">Sort &amp; Filter</value></prop><prop oor:name="PopupLabel" oor:type="xs:string"><value xml:lang="en-US">Auto~Filter</value></prop></node>
     <node oor:name=".uno:SearchDialog" oor:op="fuse"><prop oor:name="Label" oor:type="xs:string"><value xml:lang="en-US">Find &amp; Select</value></prop><prop oor:name="PopupLabel" oor:type="xs:string"><value xml:lang="en-US">Find and Rep~lace...</value></prop></node>
     <node oor:name=".uno:InsertCell" oor:op="fuse"><prop oor:name="Label" oor:type="xs:string"><value xml:lang="en-US">Insert</value></prop><prop oor:name="PopupLabel" oor:type="xs:string"><value xml:lang="en-US">Insert ~Cells...</value></prop></node>
     <node oor:name=".uno:DeleteCell" oor:op="fuse"><prop oor:name="Label" oor:type="xs:string"><value xml:lang="en-US">Delete</value></prop><prop oor:name="PopupLabel" oor:type="xs:string"><value xml:lang="en-US">Delete C~ells...</value></prop></node>
     <node oor:name=".uno:FormatCellDialog" oor:op="fuse"><prop oor:name="Label" oor:type="xs:string"><value xml:lang="en-US">Format</value></prop><prop oor:name="PopupLabel" oor:type="xs:string"><value xml:lang="en-US">Format ~Cells...</value></prop></node>
     <node oor:name=".uno:DefaultCellStyles" oor:op="fuse"><prop oor:name="Label" oor:type="xs:string"><value xml:lang="en-US">Normal</value></prop><prop oor:name="PopupLabel" oor:type="xs:string"><value xml:lang="en-US">Default</value></prop></node>
   </node>
  </node>
 </oor:component-data>

 <!-- Documents: Calibri (Carlito on screen) when a document names no font. -->
 <oor:component-data oor:name="Writer" oor:package="org.openoffice.Office">
  <node oor:name="DefaultFont">
   <prop oor:name="Document"><value>true</value></prop>
   <prop oor:name="Standard"><value>Calibri</value></prop>
   <prop oor:name="StandardHeight"><value>388</value></prop>
   <prop oor:name="Heading"><value>Calibri Light</value></prop>
   <prop oor:name="List"><value>Calibri</value></prop>
   <prop oor:name="Caption"><value>Calibri</value></prop>
   <prop oor:name="Index"><value>Calibri</value></prop>
  </node>
  <node oor:name="Filter">
   <node oor:name="Import">
    <node oor:name="VBA">
     <!-- a document's VBA runs, and is saved back -->
     <prop oor:name="Load"><value>true</value></prop>
     <prop oor:name="Executable"><value>true</value></prop>
     <prop oor:name="Save"><value>true</value></prop>
    </node>
   </node>
  </node>
 </oor:component-data>

 <!-- Spreadsheets: formulas as Excel writes and reads them. -->
 <oor:component-data oor:name="Calc" oor:package="org.openoffice.Office">
  <node oor:name="Formula">
   <node oor:name="Syntax">
    <!-- Excel A1: Sheet1!A1 references, ! in ADDRESS() and INDIRECT() -->
    <prop oor:name="Grammar"><value>1</value></prop>
    <!-- English function names and Excel's separators whatever the locale:
         =SUM(A1,B1) and {1,2;3,4} as typed in Excel -->
    <prop oor:name="EnglishFunctionName"><value>true</value></prop>
    <prop oor:name="SeparatorArg"><value>,</value></prop>
    <prop oor:name="SeparatorArrayCol"><value>,</value></prop>
    <prop oor:name="SeparatorArrayRow"><value>;</value></prop>
    <!-- text that is a number, date or time counts as one in arithmetic, as in Excel -->
    <prop oor:name="StringConversion"><value>3</value></prop>
   </node>
  </node>
  <node oor:name="Filter">
   <node oor:name="Import">
    <node oor:name="VBA">
     <!-- a workbook's VBA runs (Option VBASupport), and is saved back -->
     <prop oor:name="Load"><value>true</value></prop>
     <prop oor:name="Executable"><value>true</value></prop>
     <prop oor:name="Save"><value>true</value></prop>
    </node>
   </node>
  </node>
 </oor:component-data>

 <!-- Presentations: their VBA too (documents' is with Writer's settings above);
      a new presentation starts on its first slide, not in the template chooser. -->
 <oor:component-data oor:name="Impress" oor:package="org.openoffice.Office">
  <node oor:name="Misc">
   <node oor:name="NewDoc">
    <prop oor:name="AutoPilot"><value>false</value></prop>
   </node>
  </node>
  <node oor:name="Filter">
   <node oor:name="Import">
    <node oor:name="VBA">
     <prop oor:name="Load"><value>true</value></prop>
     <prop oor:name="Save"><value>true</value></prop>
    </node>
   </node>
  </node>
 </oor:component-data>
</oor:data>
