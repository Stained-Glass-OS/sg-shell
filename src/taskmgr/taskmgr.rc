/* sg-taskmgr resources: its icon (generated at build time, build/sg-taskmgr.ico),
 * the common-controls 6 manifest, and a version resource naming it. */
#include <winver.h>
1 ICON "sg-taskmgr.ico"
1 24 "sg-net.manifest"
VS_VERSION_INFO VERSIONINFO
FILEVERSION 1,0,0,0
PRODUCTVERSION 1,0,0,0
FILETYPE VFT_APP
BEGIN
  BLOCK "StringFileInfo"
  BEGIN
    BLOCK "040904B0"
    BEGIN
      VALUE "CompanyName", "Stained Glass OS"
      VALUE "FileDescription", "Task Manager"
      VALUE "ProductName", "Stained Glass OS"
      VALUE "InternalName", "taskmgr"
      VALUE "OriginalFilename", "sg-taskmgr64.exe"
      VALUE "FileVersion", "1.0.0.0"
    END
  END
  BLOCK "VarFileInfo"
  BEGIN
    VALUE "Translation", 0x0409, 1200
  END
END
