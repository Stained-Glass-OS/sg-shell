#include <windows.h>

1 ICON "sg-browser.ico"

VS_VERSION_INFO VERSIONINFO
FILEVERSION 1,0,0,0
PRODUCTVERSION 1,0,0,0
FILEOS VOS_NT_WINDOWS32
FILETYPE VFT_APP
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName", "Stained Glass OS"
            VALUE "FileDescription", "Get a web browser"
            VALUE "FileVersion", "1.0.0.0"
            VALUE "InternalName", "sg-browser"
            VALUE "OriginalFilename", "sg-browser64.exe"
            VALUE "ProductName", "Stained Glass OS"
            VALUE "ProductVersion", "1.0.0.0"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
