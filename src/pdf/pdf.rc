IDD_CERTSIGN DIALOGEX 0, 0, 310, 200
STYLE DS_MODALFRAME | DS_CENTER | DS_SHELLFONT | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "Sign with a Certificate"
FONT 9, "Segoe UI"
BEGIN
    LTEXT "&Digital ID (.pfx or .p12 file):", -1, 10, 8, 200, 10
    EDITTEXT IDC_CS_FILE, 10, 20, 226, 14, ES_AUTOHSCROLL | WS_TABSTOP
    PUSHBUTTON "&Browse...", IDC_CS_BROWSE, 240, 20, 60, 14, WS_TABSTOP
    PUSHBUTTON "&New Digital ID...", IDC_CS_NEWID, 240, 38, 60, 14, WS_TABSTOP
    LTEXT "&Password:", -1, 10, 42, 60, 10
    EDITTEXT IDC_CS_PW, 74, 40, 160, 14, ES_PASSWORD | ES_AUTOHSCROLL | WS_TABSTOP
    LTEXT "&Reason:", -1, 10, 62, 60, 10
    EDITTEXT IDC_CS_REASON, 74, 60, 226, 14, ES_AUTOHSCROLL | WS_TABSTOP
    LTEXT "&Location:", -1, 10, 80, 60, 10
    EDITTEXT IDC_CS_LOCATION, 74, 78, 226, 14, ES_AUTOHSCROLL | WS_TABSTOP
    AUTOCHECKBOX "&Show my handwritten signature beside it (Fill && Sign > Sign)", IDC_CS_PICTURE, 74, 98, 226, 12, WS_TABSTOP
    LTEXT "", IDC_CS_INFO, 10, 116, 290, 56
    DEFPUSHBUTTON "Sign", IDOK, 196, 178, 50, 15
    PUSHBUTTON "Cancel", IDCANCEL, 250, 178, 50, 15
END

IDD_MAKEID DIALOGEX 0, 0, 300, 176
STYLE DS_MODALFRAME | DS_CENTER | DS_SHELLFONT | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "New Digital ID"
FONT 9, "Segoe UI"
BEGIN
    LTEXT "A self-signed digital ID: signatures made with it are valid, but others see your identity as unconfirmed until they trust your certificate.", -1, 10, 6, 280, 22
    LTEXT "&Name:", -1, 10, 34, 60, 10
    EDITTEXT IDC_MI_NAME, 80, 32, 210, 14, ES_AUTOHSCROLL | WS_TABSTOP
    LTEXT "&Organization:", -1, 10, 52, 60, 10
    EDITTEXT IDC_MI_ORG, 80, 50, 210, 14, ES_AUTOHSCROLL | WS_TABSTOP
    LTEXT "&E-mail:", -1, 10, 70, 60, 10
    EDITTEXT IDC_MI_EMAIL, 80, 68, 210, 14, ES_AUTOHSCROLL | WS_TABSTOP
    LTEXT "&Password:", -1, 10, 88, 60, 10
    EDITTEXT IDC_MI_PW, 80, 86, 100, 14, ES_PASSWORD | ES_AUTOHSCROLL | WS_TABSTOP
    LTEXT "Con&firm:", -1, 186, 88, 34, 10
    EDITTEXT IDC_MI_PW2, 222, 86, 68, 14, ES_PASSWORD | ES_AUTOHSCROLL | WS_TABSTOP
    LTEXT "Save &as:", -1, 10, 108, 60, 10
    EDITTEXT IDC_MI_FILE, 80, 106, 150, 14, ES_AUTOHSCROLL | WS_TABSTOP
    PUSHBUTTON "&Browse...", IDC_MI_BROWSE, 234, 106, 56, 14, WS_TABSTOP
    DEFPUSHBUTTON "Create", IDOK, 186, 154, 50, 15
    PUSHBUTTON "Cancel", IDCANCEL, 240, 154, 50, 15
END

IDD_SCAN DIALOGEX 0, 0, 290, 150
STYLE DS_MODALFRAME | DS_CENTER | DS_SHELLFONT | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "Create PDF from Scanner"
FONT 9, "Segoe UI"
BEGIN
    LTEXT "&Scanner:", -1, 10, 10, 50, 10
    COMBOBOX IDC_SC_DEVICE, 64, 8, 160, 120, CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP
    PUSHBUTTON "&Refresh", IDC_SC_REFRESH, 228, 8, 52, 14, WS_TABSTOP
    LTEXT "&Resolution:", -1, 10, 30, 50, 10
    COMBOBOX IDC_SC_DPI, 64, 28, 70, 120, CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP
    LTEXT "&Colour:", -1, 146, 30, 36, 10
    COMBOBOX IDC_SC_MODE, 184, 28, 96, 120, CBS_DROPDOWNLIST | WS_TABSTOP
    LTEXT "S&ource:", -1, 10, 50, 50, 10
    COMBOBOX IDC_SC_SOURCE, 64, 48, 120, 120, CBS_DROPDOWNLIST | WS_TABSTOP
    LTEXT "&Pages:", -1, 192, 50, 30, 10
    EDITTEXT IDC_SC_PAGES, 224, 48, 30, 14, ES_NUMBER | WS_TABSTOP
    AUTOCHECKBOX "Recognize &text (make the scan searchable)", IDC_SC_OCR, 64, 70, 216, 12, WS_TABSTOP
    LTEXT "Each scan becomes a page. With several pages from the glass, put the next page on when the scanner stops.", -1, 10, 90, 270, 22
    DEFPUSHBUTTON "Scan", IDOK, 176, 128, 50, 15
    PUSHBUTTON "Cancel", IDCANCEL, 230, 128, 50, 15
END

