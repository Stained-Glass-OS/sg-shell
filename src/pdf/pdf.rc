IDD_WATERMARK DIALOGEX 0, 0, 300, 180
STYLE DS_MODALFRAME | DS_CENTER | DS_SHELLFONT | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "Add Watermark"
FONT 9, "Segoe UI"
BEGIN
    AUTORADIOBUTTON "&Text:", IDC_WM_USETEXT, 10, 10, 40, 12, WS_GROUP | WS_TABSTOP
    AUTORADIOBUTTON "&Picture:", IDC_WM_USEIMG, 10, 30, 44, 12
