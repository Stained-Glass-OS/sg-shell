/* PDF Viewer (sg-pdf): its icon (drawn at build time by gen-icon.py into
 * build/), the common-controls 6 manifest, the password prompt and the
 * version information (Settings > Default apps shows the FileDescription).
 *
 * Copyright (C) 2026 Stained Glass OS contributors
 * SPDX-License-Identifier: AGPL-3.0-or-later
 */
#include <windows.h>
#include "resource.h"

1 ICON "sg-pdf.ico"
1 24 "pdf.manifest"

IDD_PASSWORD DIALOGEX 0, 0, 250, 92
STYLE DS_MODALFRAME | DS_CENTER | DS_SHELLFONT | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "Password"
FONT 9, "Segoe UI"
BEGIN
    LTEXT "", IDC_PW_TEXT, 10, 8, 230, 26
    LTEXT "&Password:", -1, 10, 42, 44, 10
    EDITTEXT IDC_PW_EDIT, 58, 40, 182, 14, ES_PASSWORD | ES_AUTOHSCROLL
    DEFPUSHBUTTON "OK", IDOK, 136, 70, 50, 15
    PUSHBUTTON "Cancel", IDCANCEL, 190, 70, 50, 15
END

VS_VERSION_INFO VERSIONINFO
FILEVERSION 1,0,0,0
PRODUCTVERSION 1,0,0,0
FILEOS VOS_NT_WINDOWS32
FILETYPE VFT_APP
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName", "Stained Glass OS"
            VALUE "FileDescription", "PDF Viewer"
            VALUE "FileVersion", "1.0.0.0"
            VALUE "InternalName", "sg-pdf"
            VALUE "OriginalFilename", "sg-pdf64.exe"
            VALUE "ProductName", "Stained Glass OS"
            VALUE "ProductVersion", "1.0.0.0"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
