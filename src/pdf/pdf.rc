    AUTOCHECKBOX "&Comments and markup", IDC_SN_COMMENTS, 20, 70, 260, 12, WS_TABSTOP
    AUTOCHECKBOX "&Form fields (their values become page content)", IDC_SN_FORMS, 20, 84, 260, 12, WS_TABSTOP
    AUTOCHECKBOX "&Hidden text", IDC_SN_HIDDEN, 20, 98, 260, 12, WS_TABSTOP
    AUTOCHECKBOX "Hidden &layers", IDC_SN_LAYERS, 20, 112, 260, 12, WS_TABSTOP
    AUTOCHECKBOX "&Bookmarks", IDC_SN_BOOKMARKS, 20, 126, 260, 12, WS_TABSTOP
    AUTOCHECKBOX "Links, actions and &JavaScript", IDC_SN_LINKS, 20, 140, 260, 12, WS_TABSTOP
    AUTOCHECKBOX "Embedded &thumbnails", IDC_SN_THUMBS, 20, 154, 260, 12, WS_TABSTOP
    DEFPUSHBUTTON "Remove", IDOK, 176, 182, 50, 15
    PUSHBUTTON "Cancel", IDCANCEL, 230, 182, 50, 15
END

IDD_SPLIT DIALOGEX 0, 0, 260, 96
