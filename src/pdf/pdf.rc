#include <windows.h>
#include <commctrl.h>
#include "resource.h"

1 ICON "sg-pdf.ico"
1 24 "pdf.manifest"

IDD_PASSWORD DIALOGEX 0, 0, 250, 92
STYLE DS_MODALFRAME | DS_CENTER | DS_SHELLFONT | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "Password"
FONT 9, "Segoe UI"
BEGIN
    LTEXT "", IDC_PW_TEXT, 10, 8, 230, 26
    LTEXT "&Password:", -1, 10, 42, 44, 10
    EDITTEXT IDC_PW_EDIT, 58, 40, 182, 14, ES_PASSWORD | ES_AUTOHSCROLL
    DEFPUSHBUTTON "OK", IDOK, 136, 70, 50, 15
    PUSHBUTTON "Cancel", IDCANCEL, 190, 70, 50, 15
END

IDD_TEXT1 DIALOGEX 0, 0, 260, 76
STYLE DS_MODALFRAME | DS_CENTER | DS_SHELLFONT | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION ""
FONT 9, "Segoe UI"
BEGIN
    LTEXT "", IDC_TX_PROMPT, 10, 8, 240, 10
    EDITTEXT IDC_TX_EDIT, 10, 22, 240, 14, ES_AUTOHSCROLL
    DEFPUSHBUTTON "OK", IDOK, 146, 54, 50, 15
    PUSHBUTTON "Cancel", IDCANCEL, 200, 54, 50, 15
END

IDD_TEXTM DIALOGEX 0, 0, 260, 136
STYLE DS_MODALFRAME | DS_CENTER | DS_SHELLFONT | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION ""
FONT 9, "Segoe UI"
BEGIN
    LTEXT "", IDC_TX_PROMPT, 10, 8, 240, 10
    EDITTEXT IDC_TX_EDIT, 10, 22, 240, 84, ES_MULTILINE | ES_AUTOVSCROLL | ES_WANTRETURN | WS_VSCROLL
    DEFPUSHBUTTON "OK", IDOK, 146, 114, 50, 15
    PUSHBUTTON "Cancel", IDCANCEL, 200, 114, 50, 15
END

IDD_SIGNATURE DIALOGEX 0, 0, 300, 190
STYLE DS_MODALFRAME | DS_CENTER | DS_SHELLFONT | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "Signature"
FONT 9, "Segoe UI"
BEGIN
    AUTORADIOBUTTON "&Type", IDC_SG_TYPE, 10, 8, 50, 12, WS_GROUP | WS_TABSTOP
    AUTORADIOBUTTON "&Draw", IDC_SG_DRAW, 64, 8, 50, 12
    AUTORADIOBUTTON "&Image", IDC_SG_IMAGE, 118, 8, 50, 12
    LTEXT "Name:", -1, 10, 30, 30, 10
    EDITTEXT IDC_SG_NAME, 42, 28, 248, 14, ES_AUTOHSCROLL | WS_TABSTOP
    CONTROL "", IDC_SG_PREVIEW, "SgPdfSigPad", WS_BORDER, 10, 50, 280, 84
    CONTROL "", IDC_SG_PAD, "SgPdfSigPad", WS_BORDER, 10, 50, 280, 84
    PUSHBUTTON "C&lear", IDC_SG_CLEAR, 10, 140, 50, 15
    EDITTEXT IDC_SG_FILE, 10, 140, 226, 14, ES_AUTOHSCROLL | WS_TABSTOP
    PUSHBUTTON "&Browse...", IDC_SG_BROWSE, 240, 140, 50, 15
    DEFPUSHBUTTON "Apply", IDOK, 186, 168, 50, 15
    PUSHBUTTON "Cancel", IDCANCEL, 240, 168, 50, 15
END

IDD_PROTECT DIALOGEX 0, 0, 300, 250
STYLE DS_MODALFRAME | DS_CENTER | DS_SHELLFONT | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "Protect"
FONT 9, "Segoe UI"
BEGIN
    AUTOCHECKBOX "&Require a password to open the document", IDC_PR_OPEN, 10, 8, 280, 12, WS_TABSTOP
    LTEXT "Password:", -1, 22, 26, 70, 10
    EDITTEXT IDC_PR_UPW, 96, 24, 194, 14, ES_PASSWORD | ES_AUTOHSCROLL | WS_TABSTOP
    LTEXT "Confirm:", -1, 22, 44, 70, 10
    EDITTEXT IDC_PR_UPW2, 96, 42, 194, 14, ES_PASSWORD | ES_AUTOHSCROLL | WS_TABSTOP
    AUTOCHECKBOX "Restrict &editing and printing", IDC_PR_RESTRICT, 10, 66, 280, 12, WS_TABSTOP
    LTEXT "Permissions password:", -1, 22, 84, 74, 10
    EDITTEXT IDC_PR_OPW, 96, 82, 194, 14, ES_PASSWORD | ES_AUTOHSCROLL | WS_TABSTOP
    LTEXT "Confirm:", -1, 22, 102, 70, 10
    EDITTEXT IDC_PR_OPW2, 96, 100, 194, 14, ES_PASSWORD | ES_AUTOHSCROLL | WS_TABSTOP
    LTEXT "Allowed without the permissions password:", -1, 22, 122, 268, 10
    AUTOCHECKBOX "&Printing", IDC_PR_PRINT, 30, 136, 120, 12, WS_TABSTOP
    AUTOCHECKBOX "&Copying text and images", IDC_PR_COPY, 150, 136, 140, 12, WS_TABSTOP
    AUTOCHECKBOX "C&ommenting", IDC_PR_ANNOT, 30, 150, 120, 12, WS_TABSTOP
    AUTOCHECKBOX "&Filling in forms", IDC_PR_FORM, 150, 150, 140, 12, WS_TABSTOP
    AUTOCHECKBOX "Page &assembly", IDC_PR_ASSEMBLE, 30, 164, 120, 12, WS_TABSTOP
    AUTOCHECKBOX "Changing &content", IDC_PR_MODIFY, 150, 164, 140, 12, WS_TABSTOP
    LTEXT "The document is encrypted with AES-256. The security takes effect when you save it.", -1, 10, 186, 280, 20
    DEFPUSHBUTTON "OK", IDOK, 186, 226, 50, 15
    PUSHBUTTON "Cancel", IDCANCEL, 240, 226, 50, 15
END

IDD_EXPORT DIALOGEX 0, 0, 300, 230
STYLE DS_MODALFRAME | DS_CENTER | DS_SHELLFONT | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "Export PDF"
FONT 9, "Segoe UI"
BEGIN
    LTEXT "Export to:", -1, 10, 8, 280, 10
    AUTORADIOBUTTON "&Word document (.docx)", IDC_EX_DOCX, 20, 22, 200, 12, WS_GROUP | WS_TABSTOP
    AUTORADIOBUTTON "Plain &text (.txt)", IDC_EX_TXT, 20, 36, 200, 12
    AUTORADIOBUTTON "&HTML web page (.html)", IDC_EX_HTML, 20, 50, 200, 12
    AUTORADIOBUTTON "&PNG images, a page each", IDC_EX_PNG, 20, 64, 200, 12
    AUTORADIOBUTTON "&JPEG images, a page each", IDC_EX_JPEG, 20, 78, 200, 12
    LTEXT "Image resolution:", -1, 20, 96, 70, 10
    COMBOBOX IDC_EX_DPI, 92, 94, 60, 100, CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP
    LTEXT "Pages:", -1, 10, 116, 280, 10
    AUTORADIOBUTTON "&All", IDC_EX_ALL, 20, 130, 60, 12, WS_GROUP | WS_TABSTOP
    AUTORADIOBUTTON "C&urrent page", IDC_EX_CURRENT, 84, 130, 70, 12
    AUTORADIOBUTTON "Pa&ges:", IDC_EX_RANGE, 158, 130, 40, 12
    EDITTEXT IDC_EX_RANGETXT, 200, 128, 90, 14, ES_AUTOHSCROLL | WS_TABSTOP
    LTEXT "", IDC_EX_NOTE, 10, 152, 280, 44
    DEFPUSHBUTTON "Export", IDOK, 186, 206, 50, 15
    PUSHBUTTON "Cancel", IDCANCEL, 240, 206, 50, 15
END

IDD_COMBINE DIALOGEX 0, 0, 320, 200
STYLE DS_MODALFRAME | DS_CENTER | DS_SHELLFONT | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "Combine Files"
FONT 9, "Segoe UI"
BEGIN
    LTEXT "The files are combined into one PDF in this order (PDF documents and pictures):", -1, 10, 8, 300, 10
    LISTBOX IDC_CB_LIST, 10, 22, 236, 146, LBS_NOTIFY | WS_VSCROLL | WS_HSCROLL | WS_BORDER | WS_TABSTOP
    PUSHBUTTON "&Add Files...", IDC_CB_ADD, 252, 22, 58, 15
    PUSHBUTTON "&Remove", IDC_CB_REMOVE, 252, 42, 58, 15
    PUSHBUTTON "Move &Up", IDC_CB_UP, 252, 62, 58, 15
    PUSHBUTTON "Move &Down", IDC_CB_DOWN, 252, 82, 58, 15
    DEFPUSHBUTTON "Combine", IDOK, 206, 176, 50, 15
    PUSHBUTTON "Cancel", IDCANCEL, 260, 176, 50, 15
END

IDD_PROPERTIES DIALOGEX 0, 0, 300, 196
STYLE DS_MODALFRAME | DS_CENTER | DS_SHELLFONT | WS_POPUP | WS_CAPTION | WS_SYSMENU
