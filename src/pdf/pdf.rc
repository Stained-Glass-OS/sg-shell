IDD_FIELDPROPS DIALOGEX 0, 0, 330, 228
STYLE DS_MODALFRAME | DS_CENTER | DS_SHELLFONT | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "Field Properties"
FONT 9, "Segoe UI"
BEGIN
    LTEXT "&Name:", -1, 10, 10, 50, 10
    EDITTEXT IDC_FP_NAME, 64, 8, 256, 14, ES_AUTOHSCROLL | WS_TABSTOP
    LTEXT "&Tooltip:", -1, 10, 28, 50, 10
    EDITTEXT IDC_FP_TOOLTIP, 64, 26, 256, 14, ES_AUTOHSCROLL | WS_TABSTOP
    AUTOCHECKBOX "&Required", IDC_FP_REQUIRED, 64, 46, 70, 12, WS_TABSTOP
    AUTOCHECKBOX "Read-&only", IDC_FP_READONLY, 138, 46, 70, 12, WS_TABSTOP
    AUTOCHECKBOX "&Multi-line", IDC_FP_MULTI, 212, 46, 80, 12, WS_TABSTOP
    LTEXT "Font &size:", -1, 10, 66, 50, 10
    COMBOBOX IDC_FP_FONTSIZE, 64, 64, 60, 160, CBS_DROPDOWN | WS_VSCROLL | WS_TABSTOP
    LTEXT "&Alignment:", -1, 138, 66, 50, 10
    COMBOBOX IDC_FP_ALIGN, 190, 64, 70, 100, CBS_DROPDOWNLIST | WS_TABSTOP
    LTEXT "&Default value:", IDC_FP_DEFLABEL, 10, 86, 54, 10
    EDITTEXT IDC_FP_DEFAULT, 64, 84, 256, 14, ES_AUTOHSCROLL | WS_TABSTOP
    LTEXT "&Format:", IDC_FP_FMTLABEL, 10, 110, 50, 10
    COMBOBOX IDC_FP_FORMAT, 64, 108, 120, 200, CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP
    LTEXT "Decimals:", IDC_FP_DECLABEL, 192, 110, 36, 10
    COMBOBOX IDC_FP_DECIMALS, 230, 108, 34, 120, CBS_DROPDOWNLIST | WS_TABSTOP
    LTEXT "Symbol:", IDC_FP_CURLABEL, 270, 110, 26, 10
    EDITTEXT IDC_FP_CURRENCY, 298, 108, 22, 14, ES_AUTOHSCROLL | WS_TABSTOP
    LTEXT "Pattern:", IDC_FP_DATELABEL, 192, 110, 34, 10
    COMBOBOX IDC_FP_DATEPAT, 230, 108, 90, 160, CBS_DROPDOWN | WS_VSCROLL | WS_TABSTOP
    LTEXT "&Calculate:", IDC_FP_CALCLABEL, 10, 132, 50, 10
    COMBOBOX IDC_FP_CALC, 64, 130, 120, 200, CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP
    LTEXT "", IDC_FP_CALCHINT, 64, 148, 256, 10
    EDITTEXT IDC_FP_CALCFIELDS, 64, 160, 204, 14, ES_AUTOHSCROLL | WS_TABSTOP
    PUSHBUTTON "&Pick...", IDC_FP_CALCPICK, 272, 160, 48, 14, WS_TABSTOP
    LTEXT "C&hoices (one a line):", IDC_FP_OPTLABEL, 10, 110, 90, 10
    EDITTEXT IDC_FP_OPTIONS, 64, 122, 256, 76, ES_MULTILINE | ES_AUTOVSCROLL | ES_WANTRETURN | WS_VSCROLL | WS_TABSTOP
    LTEXT "&Export value:", IDC_FP_EXPLABEL, 10, 110, 54, 10
    EDITTEXT IDC_FP_EXPORT, 64, 108, 120, 14, ES_AUTOHSCROLL | WS_TABSTOP
    DEFPUSHBUTTON "OK", IDOK, 216, 206, 50, 15
    PUSHBUTTON "Cancel", IDCANCEL, 270, 206, 50, 15
END

IDD_PICKFIELDS DIALOGEX 0, 0, 200, 200
