    LTEXT "&Size:", -1, 10, 52, 46, 10
    EDITTEXT IDC_WM_SIZE, 60, 50, 30, 14, ES_AUTOHSCROLL | WS_TABSTOP
    LTEXT "&Rotation:", -1, 100, 52, 36, 10
    EDITTEXT IDC_WM_ROTATE, 138, 50, 30, 14, ES_AUTOHSCROLL | WS_TABSTOP
    LTEXT "&Opacity %:", -1, 178, 52, 40, 10
    EDITTEXT IDC_WM_OPACITY, 220, 50, 30, 14, ES_NUMBER | WS_TABSTOP
    LTEXT "&Colour:", -1, 10, 72, 46, 10
    COMBOBOX IDC_WM_COLOR, 60, 70, 80, 120, CBS_DROPDOWNLIST | WS_TABSTOP
    AUTOCHECKBOX "Behind the page's &content", IDC_WM_BEHIND, 150, 72, 140, 12, WS_TABSTOP
    LTEXT "&Pages (blank: all):", -1, 10, 94, 66, 10
    EDITTEXT IDC_WM_PAGES, 78, 92, 70, 14, ES_AUTOHSCROLL | WS_TABSTOP
    DEFPUSHBUTTON "OK", IDOK, 186, 158, 50, 15
    PUSHBUTTON "Cancel", IDCANCEL, 240, 158, 50, 15
END

