def adopt_source(pkg, src):
    """the maker's source through sg-apt-sources: not added when the same
    repository is configured already (Mozilla's own instructions put
    packages.mozilla.org in mozilla.list or mozilla.sources with its key in
    /etc/apt/keyrings; a second entry naming another keyring made apt refuse
    every source, David's VM 2026-10-06); False if the tool is not there"""
    if not os.access(APT_SOURCES_TOOL, os.X_OK):
        return False
    extra = {"SG_APT_ETC": os.path.dirname(APT_SOURCES)} if TEST else {}
    r = run([APT_SOURCES_TOOL, "adopt", src], timeout=300, extra_env=extra)
    for line in (r.stdout + r.stderr).splitlines():
        log("%s: %s" % (pkg, line))
    return True


def add_vendor_source(pkg):
    """the maker's apt source for a package that comes from it (Steam), put
    in place before apt looks for the package; True if it has one"""
    if pkg not in VENDOR_SOURCES:
        return False
    for name, where in VENDOR_SOURCES[pkg]:
        dst = os.path.join({"sources": APT_SOURCES, "keyrings": KEYRINGS, "preferences": PREFERENCES}[where], name)
        if where == "sources" and adopt_source(pkg, os.path.join(VENDOR_DIR, name)):
            continue
        if not os.path.exists(dst):
            shutil.copyfile(os.path.join(VENDOR_DIR, name), dst)
            os.chmod(dst, 0o644)
            log("%s: %s put in place for it" % (pkg, dst))
    return True


def apt_relations(pkg):
    """what apt's candidate for pkg depends on and recommends"""
    r = run(["apt-cache", "show", "--no-all-versions", pkg])
    return parse_relations(r.stdout) if r.returncode == 0 else {}


def op_apt_install(args):
    (pkg,) = args
    if not PKG_RE.fullmatch(pkg):
        raise Refused("'%s' is not a package name." % pkg)
    vendor = add_vendor_source(pkg)
    refresh_lists()
    rel = apt_relations(pkg)
    if wants_i386(rel) and "i386" not in foreign_archs():
        # Steam: its 32-bit libraries are i386 packages
        progress(3, "Turning on support for 32-bit programs...")
        must(["dpkg", "--add-architecture", "i386"], "Support for 32-bit programs could not be turned on")
        log("%s asks for 32-bit libraries: i386 packages turned on" % pkg)
        refresh_lists()
    apt_get(["install", pkg], "%s could not be installed" % pkg, 5, 55 if vendor else 95)
    ver = installed_version(pkg)
    if not ver:
        raise Refused("%s was not installed." % pkg)
    if pkg in OUR_PACKAGES:
        progress(97, "Registering %s..." % pkg)
        register_defaults(pkg)
    failed = install_recommends(rel, 60, 38) if vendor else []
    progress(100, "Done")
    return ["%s %s" % (pkg, ver)] + (["Not installed: %s" % " ".join(failed)] if failed else [])


# What an uninstall never removes, as asked or along the way: the system
# itself (Stained Glass OS's own packages, Wine, the compositor, the image's
# base) -- apt would take sg-shell away with a library it depends on.
PROTECTED_PREFIXES = ("sg-", "stained-glass", "wine-sg", "linux-image", "systemd", "libc6", "apt", "dpkg",
                      "greetd", "xwayland", "plymouth")
REMOVABLE_OURS = ("sg-office", "sg-office-editors")


def protected(pkg):
    if pkg in REMOVABLE_OURS:
        return False
    if pkg.startswith(PROTECTED_PREFIXES):
        return True
    r = run(["dpkg-query", "-W", "-f", "${Essential} ${Priority}", pkg])
    words = r.stdout.split() if r.returncode == 0 else []
    return "yes" in words[:1] or any(w in ("required", "important") for w in words[1:])


def simulated_removals(args):
    """the packages apt-get -s would remove ("Remv NAME [version]")"""
    r = run(["apt-get", "-s", "-q"] + args, extra_env=apt_env())
    if r.returncode != 0:
        errors = [l[3:].strip() for l in (r.stdout + r.stderr).splitlines() if l.startswith("E: ")]
        raise Refused("It cannot be uninstalled%s" % ((": " + errors[0]) if errors else "."))
    return [l.split()[1].split(":")[0] for l in r.stdout.splitlines() if l.startswith("Remv ") and len(l.split()) > 1]


def installed_depends(pkg):
    """the installed packages pkg depends on (each alternative), by name"""
    r = run(["dpkg-query", "-W", "-f", "${Pre-Depends}, ${Depends}", pkg])
    rel = parse_relations("Depends: " + r.stdout) if r.returncode == 0 else {}
    return {name for alts in rel.get("Depends", []) for name, _ in alts}


OUR_PROGIDS = re.compile(r"^HKEY_LOCAL_MACHINE\\Software\\Classes\\(?:[^\\]+\\)?SGOffice\.[^\\]+", re.I)
OUR_KEYS = re.compile(r"^HKEY_LOCAL_MACHINE\\Software\\(?:Classes\\Applications\\sg-[a-z]+64\.exe|"
                      r"Microsoft\\Windows\\CurrentVersion\\App Paths\\sg-[a-z]+\.exe|"
                      r"Stained Glass\\SG Office)(?=\\|$)", re.I)


def unregistration(reg_texts):
    """A .reg that takes our own package's registrations back out of the
    Windows side: its ProgIDs (SGOffice.*, also under an extension's key, its
    ShellNew), its programs' Applications and App Paths keys, its
    Capabilities, and its values in OpenWithProgids and
    RegisteredApplications. An extension's default stays, naming a ProgID
    that is gone, as Windows leaves it when Office is uninstalled."""
    keys, values = [], []
    for text in reg_texts:
        key = None
        for line in text.splitlines():
            line = line.strip()
            if line.startswith("[") and line.endswith("]"):
                key = line[1:-1]
                m = OUR_PROGIDS.match(key) or OUR_KEYS.match(key)
                if m and m.group(0) not in keys:
                    keys.append(m.group(0))
                continue
            if not key or OUR_PROGIDS.match(key) or OUR_KEYS.match(key):
                continue
            name = re.match(r'^"([^"]+)"=', line)
            if name and (key.lower().endswith("\\openwithprogids") and name.group(1).lower().startswith("sgoffice.")
                         or key.lower().endswith("\\software\\registeredapplications") and name.group(1) == "SG Office"):
                values.append((key, name.group(1)))
    out = ["Windows Registry Editor Version 5.00", ""]
    out += ["[-%s]" % k for k in keys]
    for k, v in values:
        out += ["", "[%s]" % k, '"%s"=-' % v]
    return "\r\n".join(out) + "\r\n"


UNREGISTER_SH = (". /usr/lib/stained-glass/sg-common.sh && sg_wine_env && "
                 "timeout 300 wine reg import \"$(winepath -w \"$1\")\" >/dev/null 2>&1 || exit 1; "
                 "shift; for f; do rm -f \"$SG_STATE/defaults/$f.sha256\"; done")


def unregister_defaults(name):
    """take our own package's registrations out of the Windows side, as the
    machine account, and forget that they were imported (so a reinstall
    imports them again at the next start too)"""
    files = [f for f in must(["dpkg-query", "-L", name], "%s's files could not be listed" % name).split("\n")
             if f.startswith(DEFAULTS_DIR + "/") and f.endswith(".reg")]
    texts = []
    for f in files:
        try:
            with open(f, "rb") as fh:
                raw = fh.read()
        except OSError:
            continue
        texts.append(raw.decode("utf-16") if raw[:2] in (b"\xff\xfe", b"\xfe\xff") else raw.decode("utf-8", "replace"))
    if not texts:
        return
    fd, path = tempfile.mkstemp(prefix="sg-unreg-", suffix=".reg", dir=WORK_DIR)
    with os.fdopen(fd, "w", newline="") as f:
        f.write(unregistration(texts))
    os.chmod(path, 0o644)
    try:
        must(["runuser", "-u", SYSTEM_USER, "--", "env", "HOME=/var/lib/stained-glass",
              "XDG_RUNTIME_DIR=/run/stained-glass", "sh", "-c", UNREGISTER_SH, "sg-unregister", path]
             + [os.path.basename(f) for f in files],
             "%s's registrations could not be removed" % name, timeout=600)
    finally:
        os.unlink(path)


def op_apt_remove(args):
    (pkg,) = args
    if not PKG_RE.fullmatch(pkg):
        raise Refused("'%s' is not a package name." % pkg)
    if not installed_version(pkg):
        raise Refused("%s is not installed." % pkg)
    progress(2, "Checking what goes with it...")
    gone = simulated_removals(["remove", pkg])
    # what it brought in that nothing else needs: its dependencies apt put
    # in for it, once it is gone (apt-get autoremove's own view, narrowed to
    # this package's -- never every leftover on the system)
    deps = installed_depends(pkg)
    for name in [pkg] + gone:
        if protected(name):
            log("apt-remove %s: refused, it would remove %s" % (pkg, name))
            raise Refused("%s cannot be uninstalled: it would remove %s, a part of the system." % (pkg, name)
                          if name != pkg else "%s is a part of the system and cannot be uninstalled." % pkg)
    if pkg in OUR_PACKAGES:
        progress(5, "Removing %s from the file types and the Start menu..." % pkg)
        unregister_defaults(pkg)
    apt_get(["remove", pkg], "%s could not be uninstalled" % pkg, 10, 60)
    if installed_version(pkg):
        raise Refused("%s was not uninstalled." % pkg)
    extra = [d for d in deps if d in simulated_removals(["autoremove"]) and not protected(d)]
    if extra:
        progress(75, "Removing what it brought with it...")
        for d in extra:
            if d in OUR_PACKAGES:
                unregister_defaults(d)
        apt_get(["remove"] + sorted(extra), "%s's parts could not be uninstalled" % pkg, 75, 24)
    progress(100, "Done")
    return ["%s" % pkg] + (["Also removed: %s" % " ".join(sorted(extra))] if extra else [])


def deb_fields(path):
    r = run(["dpkg-deb", "--show", "--showformat=${Package}\\n${Version}\\n${Architecture}\\n", path])
    if r.returncode != 0:
        raise Refused("The file is not a Linux software package (.deb).")
    f = r.stdout.split("\n")
    if len(f) < 3:
        raise Refused("The file is not a Linux software package (.deb).")
    return f[0], f[1], f[2]


def foreign_archs():
    return run(["dpkg", "--print-foreign-architectures"]).stdout.split()


def arch_ok(arch):
    if arch == "all":
        return True
    native = run(["dpkg", "--print-architecture"]).stdout.strip()
    return arch == native or arch in foreign_archs()


def parse_relations(text):
    """Pre-Depends, Depends and Recommends of control fields, as lists of
    alternatives [(name, arch)]"""
    fields, cur = {}, None
    for line in text.splitlines():
        if line[:1] in (" ", "\t") and cur:
            fields[cur] += " " + line.strip()
        elif ":" in line:
            cur, _, v = line.partition(":")
            fields[cur.strip()] = v.strip()
    rel = {}
    for key, value in fields.items():
        if key not in ("Pre-Depends", "Depends", "Recommends"):
            continue
        groups = []
        for group in value.split(","):
            alts = []
            for alt in group.split("|"):
                name = re.sub(r"\(.*?\)|\[.*?\]|<.*?>", "", alt).strip()
                name, _, arch = name.partition(":")
                if name:
                    alts.append((name, arch))
            if alts:
                groups.append(alts)
        rel[key] = groups
    return rel


def deb_relations(path):
    """the package's Pre-Depends, Depends and Recommends as lists of
    alternatives [(name, arch)], and whether it brings apt sources of its own
    (Steam's: its libraries come from there)"""
    r = run(["dpkg-deb", "-f", path, "Pre-Depends", "Depends", "Recommends"])
    rel = parse_relations(r.stdout)
    listing = run(["dpkg-deb", "-c", path]).stdout
    sources = bool(re.search(r" \./etc/apt/sources\.list\.d/[^/\s]+\.(list|sources)$", listing, re.M))
    return rel, sources


def wants_i386(rel):
    """a package that asks for 32-bit x86 libraries (Steam: steam-libs-i386)"""
    return any(name.endswith("-i386") or arch == "i386"
               for groups in rel.values() for alts in groups for name, arch in alts)


def install_recommends(rel, base, span):
    """the Recommends apt could not see when the package went in: ones from
    the sources the package itself added (Steam's steam-libs-amd64 and
    steam-libs-i386). Each on its own, and a failure is only noted -- the
    package is installed. Answers the names that did not install."""
    missing = [alts[0][0] for alts in rel.get("Recommends", [])
               if not any(installed_version(n) for n, _ in alts) and PKG_RE.fullmatch(alts[0][0])]
    if not missing:
        return []
    refresh_lists()
    i386 = "i386" in foreign_archs()
    failed = []
    for i, name in enumerate(missing):
        target = name + ":i386" if i386 and name.endswith("-i386") else name
        try:
            apt_get(["install", target], "%s could not be installed" % name,
                    base + span * i / len(missing), span / len(missing))
        except Refused as e:
            log("recommended %s: %s" % (name, e))
            failed.append(name)
    return failed


def take_staged(name):
    """the staged file's bytes, copied into a folder of ours; the staged file
    goes. Only SYSTEM's own regular file, never through a link."""
    if not STAGED_RE.fullmatch(name):
        raise Refused("'%s' is not a staged package." % name)
    try:
        dfd = os.open(DEBS_SRC, os.O_RDONLY | os.O_DIRECTORY | os.O_NOFOLLOW | os.O_CLOEXEC)
    except OSError:
        raise Refused("The staging folder for packages is missing.")
    work = tempfile.mkdtemp(prefix="sg-deb-", dir=WORK_DIR)
    try:
        try:
            fd = os.open(name, os.O_RDONLY | os.O_NOFOLLOW | os.O_NONBLOCK | os.O_CLOEXEC, dir_fd=dfd)
        except OSError:
            raise Refused("The package was not staged.")
        try:
            st = os.fstat(fd)
            if not stat.S_ISREG(st.st_mode) or st.st_nlink != 1 or st.st_uid != system_uid():  # SYSTEM's own
                raise Refused("The package was not staged by an administrator.")
            if st.st_size > MAX_DEB:
                raise Refused("The package is too large.")
            dst = os.path.join(work, "package.deb")
            out = os.open(dst, os.O_WRONLY | os.O_CREAT | os.O_EXCL | os.O_NOFOLLOW | os.O_CLOEXEC, 0o644)
            with os.fdopen(out, "wb") as o:
                while True:
                    chunk = os.read(fd, 1 << 20)
                    if not chunk:
                        break
                    o.write(chunk)
        finally:
            os.close(fd)
            try:
                os.unlink(name, dir_fd=dfd)
            except OSError:
                pass
    except BaseException:
        shutil.rmtree(work, ignore_errors=True)
        raise
    finally:
        os.close(dfd)
    # apt's download sandbox (_apt) reads the file: the folder is ours, 0755
    os.chmod(work, 0o755)
    return work, dst


def op_deb_install(args):
    name, want_pkg, want_ver = args
    if not PKG_RE.fullmatch(want_pkg) or not VERSION_RE.fullmatch(want_ver):
        raise Refused("That is not a package and version.")
    progress(1, "Checking the package...")
    work, deb = take_staged(name)
    try:
        pkg, ver, arch = deb_fields(deb)
        if (pkg, ver) != (want_pkg, want_ver):
            raise Refused("The file changed: it is now %s %s, not the %s %s that was shown. Nothing was installed."
                          % (pkg, ver, want_pkg, want_ver))
        if not arch_ok(arch):
            raise Refused("%s is built for another kind of processor (%s)." % (pkg, arch))
        rel, sources = deb_relations(deb)
        if wants_i386(rel) and "i386" not in foreign_archs():
            # Steam and other 32-bit games: their libraries are i386 packages,
            # which apt installs only with the architecture turned on
            progress(2, "Turning on support for 32-bit programs...")
            must(["dpkg", "--add-architecture", "i386"], "Support for 32-bit programs could not be turned on")
            log("%s asks for 32-bit libraries: i386 packages turned on" % pkg)
        refresh_lists()
        apt_get(["install", deb], "%s could not be installed" % pkg, 5, 55 if sources else 95)
    finally:
        shutil.rmtree(work, ignore_errors=True)
    got = installed_version(pkg)
    if got != ver:
        raise Refused("%s %s was not installed." % (pkg, ver))
    failed = install_recommends(rel, 60, 38) if sources else []
    progress(100, "Done")
    return ["%s %s" % (pkg, ver)] + (["Not installed: %s" % " ".join(failed)] if failed else [])


