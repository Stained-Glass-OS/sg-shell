def op_source_enable(args):
    fname, on = args
    if on not in ("yes", "no") or not SOURCE_FILE_RE.fullmatch(fname):
        raise Refused("Nothing to change.")
    path = os.path.join(APT_SOURCES, fname)
    st = os.lstat(path) if os.path.lexists(path) else None
    if not st or not stat.S_ISREG(st.st_mode):
        raise Refused("There is no source %s." % fname)
    with open(path) as f:
        lines = f.read().splitlines()
    out, seen = [], False
    for line in lines:
        if re.match(r"^Enabled:", line, re.IGNORECASE):
            line, seen = "Enabled: %s" % on, True
        out.append(line)
    if not seen:
        # every stanza of the file (a blank line ends one)
        out2, in_stanza = [], False
        for line in out + [""]:
            if not line.strip() and in_stanza:
                out2.append("Enabled: %s" % on)
                in_stanza = False
            elif line.strip() and not line.startswith("#"):
                in_stanza = True
            out2.append(line)
        out = out2[:-1]
    write_file(path, "\n".join(out) + "\n")
    return []


FONT_RE = re.compile(r"^[A-Za-z0-9][A-Za-z0-9 ._()+-]{0,120}\.(ttf|otf|ttc|fon|fnt)$", re.IGNORECASE)
FONT_MAGIC = (b"\x00\x01\x00\x00", b"OTTO", b"true", b"ttcf", b"MZ")


def font_name(name):
    if not FONT_RE.fullmatch(name) or ".." in name:
        raise Refused("'%s' is not a font file name." % name)
    return name


def fonts_dst_dir():
    """/usr/local/share/fonts/stained-glass, made if missing, never through a link"""
    parent = os.path.dirname(FONTS_DST)
    os.makedirs(parent, 0o755, exist_ok=True)
    try:
        os.mkdir(FONTS_DST, 0o755)
    except FileExistsError:
        pass
    st = os.lstat(FONTS_DST)
    if not stat.S_ISDIR(st.st_mode):
        raise Refused("The fonts folder is not a folder.")
    return FONTS_DST


def op_font_install(args):
    name = font_name(args[0])
    try:
        dfd = os.open(FONTS_SRC, os.O_RDONLY | os.O_DIRECTORY | os.O_NOFOLLOW | os.O_CLOEXEC)
    except OSError:
        raise Refused("The system fonts folder is missing.")
    try:
        try:
            fd = os.open(name, os.O_RDONLY | os.O_NOFOLLOW | os.O_NONBLOCK | os.O_CLOEXEC, dir_fd=dfd)
        except OSError:
            raise Refused("%s is not in the system fonts folder." % name)
        try:
            st = os.fstat(fd)
            # SYSTEM's own regular file, not a link to something else
            if not stat.S_ISREG(st.st_mode) or st.st_nlink != 1 or st.st_uid != system_uid():
                raise Refused("%s was not installed by an administrator." % name)
            if st.st_size > MAX_FONT:
                raise Refused("%s is too large for a font." % name)
            data = os.read(fd, MAX_FONT + 1)
        finally:
            os.close(fd)
    finally:
        os.close(dfd)
    if not data.startswith(FONT_MAGIC):
        raise Refused("%s is not a font." % name)
    dst = fonts_dst_dir()
    tmp = os.path.join(dst, ".%s.tmp" % name)
    fd = os.open(tmp, os.O_WRONLY | os.O_CREAT | os.O_TRUNC | os.O_NOFOLLOW | os.O_CLOEXEC, 0o644)
    with os.fdopen(fd, "wb") as f:
        f.write(data)
    os.chmod(tmp, 0o644)
    os.replace(tmp, os.path.join(dst, name))
    run(["fc-cache", "-f", dst])
    return [os.path.join(dst, name)]


def op_font_remove(args):
