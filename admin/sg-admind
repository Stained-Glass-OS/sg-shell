TIME_RE = re.compile(r"(\d{4})-(\d{2})-(\d{2}) (\d{2}):(\d{2}):(\d{2})")


def op_time(args):
    """Set the clock by hand, as Date & time's "Change" does. Refused while
    the clock is synchronised: Windows greys the button out then too."""
    (when,) = args
    m = TIME_RE.fullmatch(when)
    if not m:
        raise Refused("'%s' is not a date and time." % when)
    y, mo, d, h, mi, s = (int(x) for x in m.groups())
    try:
        time.strptime(when, "%Y-%m-%d %H:%M:%S")
    except ValueError:
        raise Refused("'%s' is not a date and time." % when)
    if not 2000 <= y <= 2099:
        raise Refused("The year must be between 2000 and 2099.")
    out = run(["timedatectl", "show", "--property=NTP", "--value"])
    if out.returncode == 0 and out.stdout.strip() == "yes":
        raise Refused("Turn off \"Set time automatically\" first.")
    must(["timedatectl", "set-time", when], "The time could not be changed")
    return []


