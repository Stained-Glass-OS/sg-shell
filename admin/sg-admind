def apt_env():
    return {"PATH": PATH, "LANG": "C.UTF-8", "DEBIAN_FRONTEND": "noninteractive",
            "APT_LISTCHANGES_FRONTEND": "none", "NEEDRESTART_MODE": "a"}


def apt_get(args, what, base=0, span=100):
    """apt-get with its status on a pipe: dlstatus (downloading) and pmstatus
    (dpkg) lines become the progress file, base..base+span percent."""
    rfd, wfd = os.pipe()
    log_fd, log_path = tempfile.mkstemp(prefix="sg-apt-", dir=WORK_DIR)
    argv = ["apt-get", "-y", "-q", "-o", "APT::Status-Fd=%d" % wfd, "-o", "DPkg::Lock::Timeout=600",
            "-o", "Dpkg::Options::=--force-confdef", "-o", "Dpkg::Options::=--force-confold"] + args
    try:
        try:
            p = subprocess.Popen(argv, stdin=subprocess.DEVNULL, stdout=log_fd, stderr=subprocess.STDOUT,
                                 pass_fds=(wfd,), env=apt_env())
        except FileNotFoundError:
            raise Refused("apt-get is not installed.")
        finally:
            os.close(wfd)
        with os.fdopen(rfd, "r", errors="replace") as status:
            for line in status:
                parts = line.rstrip("\n").split(":", 3)
                if len(parts) < 4 or parts[0] not in ("dlstatus", "pmstatus"):
                    continue
                try:
                    pct = float(parts[2])
                except ValueError:
                    continue
                if parts[0] == "dlstatus":      # downloading: the first half
                    progress(base + span * pct / 200, parts[3])
                else:                           # unpacking and setting up: the second
                    progress(base + span / 2 + span * pct / 200, parts[3])
        try:
            rc = p.wait(timeout=3 * 3600)
        except subprocess.TimeoutExpired:
            p.kill()
            raise Refused("%s did not finish in time." % what)
        os.lseek(log_fd, 0, os.SEEK_SET)
        out = os.read(log_fd, 1 << 20).decode("utf-8", "replace")
    finally:
        os.close(log_fd)
        os.unlink(log_path)
    if rc != 0:
        errors = [l[3:].strip() for l in out.splitlines() if l.startswith("E: ")]
        log("apt-get %s failed (%d): %s" % (" ".join(args), rc, errors[-1] if errors else out.strip()[-300:]))
        raise Refused("%s%s" % (what, (": " + errors[0]) if errors else "."))
    return out


def refresh_lists():
    """the package lists, so apt finds today's versions (offline: carry on)"""
    progress(1, "Getting the list of packages...")
