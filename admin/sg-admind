}
# how many of the last fields are passwords (never logged)
SECRET = {"join-domain": 1, "user-add": 1, "user-password": 1, "user-password-own": 2}


def system_uid():
    if TEST:
        return int(os.environ.get("SG_ADMIN_SYSTEM_UID", os.geteuid()))
    import pwd
    return pwd.getpwnam(SYSTEM_USER).pw_uid


def system_gid():
    import grp
    return grp.getgrnam(SYSTEM_USER).gr_gid


ID_RE = re.compile(r"^([0-9a-f]{16,64})\.req$")


def read_request(dirfd, name, uid):
    """The request's fields, or None if it is not one we may act on."""
    try:
        fd = os.open(name, os.O_RDONLY | os.O_NOFOLLOW | os.O_NONBLOCK | os.O_CLOEXEC, dir_fd=dirfd)
    except OSError as e:
        log("%s: not opened: %s" % (name, e))
        return None
    try:
        st = os.fstat(fd)
        if not stat.S_ISREG(st.st_mode) or st.st_uid != uid or st.st_nlink != 1:
            log("%s: refused: not a request from SYSTEM" % name)
            return None
        data = os.read(fd, MAX_REQUEST + 1)
    finally:
        os.close(fd)
    if len(data) > MAX_REQUEST:
        log("%s: refused: too large" % name)
        return None
    try:
        text = data.decode("utf-8")
    except UnicodeDecodeError:
        return [""]
    return text.split("\n")[:-1] if text.endswith("\n") else text.split("\n")


def answer(req_id, lines):
    replies = os.path.join(SPOOL, "replies")
    tmp = os.path.join(replies, ".%s.tmp" % req_id)
    fd = os.open(tmp, os.O_WRONLY | os.O_CREAT | os.O_EXCL | os.O_NOFOLLOW, 0o640)
    with os.fdopen(fd, "w") as f:
        f.write("\n".join(lines) + "\n")
    if not TEST:
        os.chown(tmp, 0, system_gid())
    os.replace(tmp, os.path.join(replies, "%s.rep" % req_id))
    try:
        os.unlink(os.path.join(replies, "%s.progress" % req_id))
    except OSError:
        pass


def handle(fields):
    verb, args = (fields[0], fields[1:]) if fields else ("", [])
    if verb not in OPS:
        raise Refused("Unknown request.")
    fn, n = OPS[verb]
    if len(args) != n:
        raise Refused("Malformed request.")
    shown = args[:-SECRET[verb]] if verb in SECRET else args
    log("%s %s" % (verb, " ".join(repr(a) for a in shown)))
    return fn(args)


def process():
    global CURRENT_ID
    uid = system_uid()
    reqdir = os.path.join(SPOOL, "requests")
    dirfd = os.open(reqdir, os.O_RDONLY | os.O_DIRECTORY | os.O_NOFOLLOW)
    try:
        for name in sorted(os.listdir(dirfd)):
            m = ID_RE.match(name)
            if not m:
                # a half-written request (renamed into place when complete) is
                # left alone; anything else that is stale is cleared
                try:
                    st = os.stat(name, dir_fd=dirfd, follow_symlinks=False)
                    if time.time() - st.st_mtime > 600:
                        os.unlink(name, dir_fd=dirfd)
                except OSError:
                    pass
                continue
            fields = read_request(dirfd, name, uid)
            try:
                os.unlink(name, dir_fd=dirfd)
            except OSError:
                pass
            if fields is None:
                continue
            CURRENT_ID = m.group(1)
            try:
                detail = handle(fields)
                reply = ["OK"] + detail
                log("%s: done" % fields[0])
            except Refused as e:
                reply = ["FAILED %s" % e]
                log("%s: refused: %s" % (fields[0] if fields else "?", e))
            except Exception as e:   # never leave the elevated program waiting
                reply = ["FAILED Something went wrong."]
                log("%s: error: %r" % (fields[0] if fields else "?", e))
            fields = None
            answer(m.group(1), reply)
            CURRENT_ID = None
    finally:
        os.close(dirfd)
    # old answers nobody collected
    replies = os.path.join(SPOOL, "replies")
    for name in os.listdir(replies):
        p = os.path.join(replies, name)
        try:
            if time.time() - os.lstat(p).st_mtime > 600:
                os.unlink(p)
        except OSError:
            pass


if __name__ == "__main__":
    process()
