#!/usr/bin/python3
# sg-admind -- the Control Panel's privileged half: machine administration
# for an elevated (SYSTEM) program.
#
# On Windows an administrator's elevated token may rename the computer, join
# a domain, manage local accounts and set the time zone. On Stained Glass the
# elevated token is the SYSTEM account (ADR 0012), which is unprivileged on
# the Unix side, and these are root's jobs. This is the narrow bridge: a fixed
# list of operations, each validated here, run as root for a request that only
# SYSTEM can make.
#
# Transport is a spool, because Wine gives a Windows program neither AF_UNIX
# sockets nor pipes to a native child:
#
#   /run/stained-glass-admin/requests   sgsystem 0700 -- only SYSTEM (and
#                                        root) can put a request here
#   /run/stained-glass-admin/replies    root:sgsystem 0750 -- SYSTEM reads the
#                                        answer, cannot forge one
#
# A request is <id>.req (id: 16-64 hex digits), UTF-8, one field per line:
# the verb, then its arguments; a password is always the last field. It is
# written as something else and renamed, so it is whole when it appears.
# sg-admind.path starts this (as root) when one appears; each request is
# read without following links, must be a regular file owned by SYSTEM, is
# deleted as it is read, and is answered in replies/<id>.rep:
#
#   OK                  or   FAILED <what to tell the person>
#   <detail lines>
#
# Verbs:
#   ping
#   hostname NAME
#   join-domain REALM USER DC PASSWORD        (DC may be empty)
#   user-add NAME FULLNAME standard|administrator PASSWORD
#   user-type NAME standard|administrator
#   user-password NAME PASSWORD        an administrator's reset (chpasswd)
#   user-password-own NAME CURRENT PASSWORD
#                            a person changing their own password: the
#                            current one is checked and their keyring
#                            re-encrypted (sg-password-change, sg-session)
#   user-remove NAME keep|delete
#   timezone AREA/CITY                 (and "automatically" off)
#   timezone-auto on|off                Set time zone automatically (sg-timezone-auto)
#   ntp on|off
#   time YYYY-MM-DD HH:MM:SS                 (only with synchronisation off)
#   update-check
#   source-add NAME URI SUITES COMPONENTS   where updates come from: a deb822
#   source-remove NAME                     /etc/apt/sources.list.d/sg-user-NAME.sources
#   source-enable FILE yes|no              any .sources file there: Enabled:
#   font-install FILE        a font SYSTEM put in the machine's %WINDIR%\Fonts,
#   font-remove FILE         copied to (removed from) /usr/local/share/fonts/
#                            stained-glass for Linux programs (fontconfig)
#   apt-install PACKAGE      SG Store's Linux apps: apt-get install PACKAGE
#   apt-remove PACKAGE       SG Store's Uninstall: apt-get remove PACKAGE, and
#                            what it alone brought in (its dependencies apt
#                            installed for it, now needed by nothing); never
#                            the system's own packages. Our own (SG Office)
#                            are unregistered from the Windows side first.
#   deb-install FILE PACKAGE VERSION
#                            a .deb SYSTEM copied into /var/cache/stained-
#                            glass-admin/debs (SG Store's "Install a Linux
#                            package"), installed with apt so its dependencies
#                            come too -- only if it is still the PACKAGE at
#                            VERSION the person was shown
#
# The two installs publish their progress while apt runs, for the elevated
# program's progress bar: replies/<id>.progress (root:sgsystem 0640),
# "PROGRESS <percent>" and a line saying what apt is doing.
#
# Copyright (C) 2026 Stained Glass OS contributors
# SPDX-License-Identifier: AGPL-3.0-or-later
import os
import re
import shutil
import stat
import subprocess
import sys
import tempfile
import time

SPOOL = "/run/stained-glass-admin"
SYSTEM_USER = "sgsystem"
WINE_GROUP = "sgwine"
ADMIN_GROUPS = ("sg-admins", "sudo")   # an administrator is in both (sg-install)
ADMIN_GROUP = "sg-admins"              # ... and this one is the definition
ZONEINFO = "/usr/share/zoneinfo"
MAX_REQUEST = 16384
RESERVED = {"root", "sgsystem", "sguser", "sggreet", "nobody", "daemon", "bin",
            "sys", "admin", "administrator", "guest", "system"}
PATH = "/usr/sbin:/usr/bin:/sbin:/bin"

# "Install for all users" in the font viewer / Fonts folder: SYSTEM writes the
# file into the machine prefix's Windows\Fonts; Linux programs get a copy here.
FONTS_SRC = "/var/lib/stained-glass/prefix/drive_c/windows/Fonts"
FONTS_DST = "/usr/local/share/fonts/stained-glass"
MAX_FONT = 64 << 20

# SG Store's .deb files: SYSTEM copies one here (only it may write here;
# sg-admind.tmpfiles), sg-admind takes it into a folder of its own.
DEBS_SRC = "/var/cache/stained-glass-admin/debs"
WORK_DIR = "/var/tmp"
MAX_DEB = 4 << 30
CURRENT_ID = None      # the request being answered (its progress file)

# Apt sources some packages need from their makers, as the makers' own packages
# ship them (identical files, which the package then takes over): Steam's
# launcher and 32-bit libraries come from Valve's repository; the Linux builds
# of Chrome, Edge and Firefox from Google's, Microsoft's and Mozilla's.
VENDOR_DIR = "/usr/share/stained-glass/apt-vendors"
KEYRINGS = "/usr/share/keyrings"
PREFERENCES = "/etc/apt/preferences.d"
# sg-session's: puts a maker's source in place unless that repository is
# configured already, and keeps apt's sources readable (sg-apt-sources heal)
APT_SOURCES_TOOL = "/usr/lib/stained-glass/sg-apt-sources"
TEST = os.geteuid() != 0 and os.environ.get("SG_ADMIN_TEST") == "1"
if TEST:
    # The gate runs this unprivileged against a spool of its own, with stand-ins
    # for the system tools first in PATH. Never honoured as root.
    SPOOL = os.environ.get("SG_ADMIN_SPOOL", SPOOL)
    PATH = os.environ.get("SG_ADMIN_PATH", "") + ":" + PATH
    ZONEINFO = os.environ.get("SG_ADMIN_ZONEINFO", ZONEINFO)
    FONTS_SRC = os.environ.get("SG_ADMIN_FONTS_SRC", FONTS_SRC)
    FONTS_DST = os.environ.get("SG_ADMIN_FONTS_DST", FONTS_DST)
    DEBS_SRC = os.environ.get("SG_ADMIN_DEBS", DEBS_SRC)
    WORK_DIR = os.environ.get("SG_ADMIN_WORK", WORK_DIR)
    VENDOR_DIR = os.environ.get("SG_ADMIN_VENDORS", VENDOR_DIR)
    KEYRINGS = os.environ.get("SG_ADMIN_KEYRINGS", KEYRINGS)
    PREFERENCES = os.environ.get("SG_ADMIN_PREFERENCES", PREFERENCES)
    APT_SOURCES_TOOL = os.environ.get("SG_ADMIN_APT_SOURCES_TOOL", APT_SOURCES_TOOL)


class Refused(Exception):
    pass


def log(msg):
    sys.stderr.write("sg-admind: %s\n" % msg)
    sys.stderr.flush()


def run(argv, stdin=None, timeout=120, extra_env=None):
    env = {"PATH": PATH, "LANG": "C.UTF-8"}
    env.update(extra_env or {})
    try:
        r = subprocess.run(argv, input=stdin, capture_output=True, text=True,
                           timeout=timeout, env=env,
                           stdin=None if stdin is not None else subprocess.DEVNULL)
    except FileNotFoundError:
        raise Refused("%s is not installed." % argv[0])
    except subprocess.TimeoutExpired:
        raise Refused("%s did not finish in time." % argv[0])
    return r


def must(argv, what, stdin=None, timeout=120, extra_env=None):
    r = run(argv, stdin, timeout, extra_env)
    if r.returncode != 0:
        why = (r.stderr or r.stdout).strip().splitlines()
        log("%s failed (%d): %s" % (argv[0], r.returncode, why[-1] if why else ""))
        raise Refused("%s%s" % (what, (": " + why[-1]) if why else "."))
    return r.stdout


# ---- facts, through getent so the gate's stand-ins answer ------------------
def passwd_entry(name):
    r = run(["getent", "passwd", name])
    if r.returncode != 0:
        return None
    f = r.stdout.strip().split(":")
    return f if len(f) >= 7 else None


def group_members(group):
    r = run(["getent", "group", group])
    if r.returncode != 0:
        return []
    f = r.stdout.strip().split(":")
    return [m for m in f[3].split(",") if m] if len(f) >= 4 else []


def local_account(name):
    """A person's local account: uid 1000-59999 in /etc/passwd, not reserved."""
    e = passwd_entry(name)
    if not e:
        raise Refused("There is no account named %s." % name)
    uid = int(e[2])
    if uid < 1000 or uid >= 60000 or name in RESERVED:
        raise Refused("%s is not a person's account and cannot be changed here." % name)
    return e


def administrators():
    return [m for m in group_members(ADMIN_GROUP) if passwd_entry(m)]


def role():
    try:
        with open("/etc/stained-glass/role") as f:
            for line in f:
                if line.startswith("role="):
                    return line.strip()[5:]
    except OSError:
        pass
    return ""


def signed_in(name):
    r = run(["loginctl", "show-user", name, "--property=State", "--value"])
    return r.returncode == 0 and r.stdout.strip() in ("active", "online", "lingering")


# ---- validation --------------------------------------------------------------
NAME_RE = re.compile(r"^[a-z_][a-z0-9_-]{0,31}$")
HOST_RE = re.compile(r"^[A-Za-z0-9]([A-Za-z0-9-]{0,13}[A-Za-z0-9])?$")
REALM_RE = re.compile(r"^[A-Za-z0-9]([A-Za-z0-9-]*[A-Za-z0-9])?(\.[A-Za-z0-9]([A-Za-z0-9-]*[A-Za-z0-9])?)+$")
JOINUSER_RE = re.compile(r"^[A-Za-z0-9._-]{1,64}$")
IPV4_RE = re.compile(r"^[0-9]{1,3}(\.[0-9]{1,3}){3}$")
ZONE_RE = re.compile(r"^[A-Za-z][A-Za-z0-9_+-]*(/[A-Za-z0-9][A-Za-z0-9_+-]*){0,2}$")


def account_name(name):
    if not NAME_RE.match(name):
        raise Refused("'%s' is not a valid account name: use lower-case letters, digits, - and _, starting with a letter." % name)
    if name in RESERVED:
        raise Refused("'%s' is reserved." % name)
    return name


def password(pw):
    if not pw:
        raise Refused("The password cannot be empty.")
    if len(pw) > 256 or any(c in pw for c in "\n\r\0"):
        raise Refused("That password cannot be used.")
    return pw


def kind(k):
    if k not in ("standard", "administrator"):
        raise Refused("The account type must be standard or administrator.")
    return k


# ---- the operations ------------------------------------------------------------
def op_ping(args):
    return ["pong"]


def op_hostname(args):
    (name,) = args
    if not HOST_RE.match(name):
        raise Refused("'%s' is not a valid computer name: up to 15 letters, digits and hyphens, not starting or ending with a hyphen." % name)
    if role() in ("member", "dc"):
        raise Refused("This computer is part of a domain. Renaming it is done through the domain.")
    must(["hostnamectl", "set-hostname", name], "The computer could not be renamed")
    # Debian names the machine itself on 127.0.1.1
    hosts = "/etc/hosts" if not TEST else os.environ.get("SG_ADMIN_HOSTS", "/dev/null")
    try:
        with open(hosts) as f:
            lines = f.read().splitlines()
        out, done = [], False
        for line in lines:
            if line.split()[:1] == ["127.0.1.1"]:
                line, done = "127.0.1.1\t%s" % name, True
            out.append(line)
        if not done:
            out.append("127.0.1.1\t%s" % name)
        with open(hosts + ".sg-new", "w") as f:
            f.write("\n".join(out) + "\n")
        os.chmod(hosts + ".sg-new", 0o644)
        os.replace(hosts + ".sg-new", hosts)
    except OSError as e:
        log("hosts not updated: %s" % e)
    return ["restart"]


def op_join_domain(args):
    realm, user, dc, pw = args
    if not REALM_RE.match(realm):
        raise Refused("'%s' is not a domain name (for example corp.example.com)." % realm)
    if not JOINUSER_RE.match(user):
        raise Refused("'%s' is not an account name." % user)
    if dc and not IPV4_RE.match(dc):
        raise Refused("The domain controller must be given as an IPv4 address.")
    if role():
        raise Refused("This computer is already a %s." % ("domain controller" if role() == "dc" else "domain member"))
    argv = ["sg-domain-join", "--domain", realm, "--user", user, "--password-stdin"]
    if dc:
        argv += ["--dc", dc]
    must(argv, "The computer could not join %s" % realm, stdin=password(pw) + "\n", timeout=600)
    return ["restart"]


def op_user_add(args):
    name, full, k, pw = args
    account_name(name)
    kind(k)
    password(pw)
    if len(full) > 64 or any(c in full for c in ":\n\r\0,"):
        raise Refused("The full name cannot contain ':' or ','.")
    if passwd_entry(name):
        raise Refused("There is already an account named %s." % name)
    groups = [WINE_GROUP] + (list(ADMIN_GROUPS) if k == "administrator" else [])
    groups = [g for g in groups if run(["getent", "group", g]).returncode == 0]
    must(["useradd", "-m", "-s", "/bin/bash", "-c", full or name, "-G", ",".join(groups), name],
         "The account could not be created")
    try:
        must(["chpasswd"], "The password could not be set", stdin="%s:%s\n" % (name, pw))
    except Refused:
        run(["userdel", "-r", name])
        raise
    return []


def op_user_type(args):
    name, k = args
    account_name(name)
    kind(k)
    local_account(name)
    admins = administrators()
    if k == "standard":
        if name in admins and len(admins) <= 1:
            raise Refused("%s is the only administrator. Make another account an administrator first." % name)
        for g in ADMIN_GROUPS:
            if name in group_members(g):
                must(["gpasswd", "-d", name, g], "The account type could not be changed")
    else:
        for g in ADMIN_GROUPS:
            if run(["getent", "group", g]).returncode == 0 and name not in group_members(g):
                must(["gpasswd", "-a", name, g], "The account type could not be changed")
    return ["signout"]


def op_user_password(args):
    name, pw = args
    account_name(name)
    local_account(name)
    must(["chpasswd"], "The password could not be changed", stdin="%s:%s\n" % (name, password(pw)))
    return []


PWCHANGE = "/usr/libexec/stained-glass/sg-password-change"
if TEST:
    PWCHANGE = os.environ.get("SG_ADMIN_PWCHANGE", PWCHANGE)


def op_user_password_own(args):
    """A person changes their own password, giving the current one.

    sg-password-change (sg-session) does it as passwd(1) would for them:
    PAM checks the current password and the password rules, and
    pam_gnome_keyring re-encrypts the keyring their programs keep passwords
    in, so it still opens at sign-in. A reset (user-password, chpasswd)
    cannot: there is no current password to open the keyring with."""
    name, current, new = args
    account_name(name)
    local_account(name)
    password(new)
    if not current or len(current) > 256 or any(c in current for c in "\n\r\0"):
        raise Refused("The current password is incorrect.")
    if not os.access(PWCHANGE, os.X_OK):
        # an sg-session without it: the reset, as before (the keyring stays
        # on the old password)
        log("%s missing: resetting the password instead" % PWCHANGE)
        return op_user_password([name, new])
    r = run([PWCHANGE], stdin="%s\0%s\0%s\0" % (name, current, new), timeout=90)
    out = (r.stdout or "").strip().splitlines()
    first = out[0] if out else ""
    if r.returncode == 0 and first == "OK":
        return []
    if first == "FAIL current":
        raise Refused("The current password is incorrect.")
    why = first[5:] if first.startswith("FAIL ") else "(no answer)"
    log("sg-password-change failed (%d): %s" % (r.returncode, why))
    raise Refused("The password could not be changed: %s" % why)


def op_user_remove(args):
    name, how = args
    account_name(name)
    if how not in ("keep", "delete"):
        raise Refused("Choose whether to keep or delete the account's files.")
    local_account(name)
    if name in administrators() and len(administrators()) <= 1:
        raise Refused("%s is the only administrator and cannot be removed." % name)
    if signed_in(name):
        raise Refused("%s is signed in. They must sign out before the account can be removed." % name)
    must(["userdel"] + (["-r"] if how == "delete" else []) + [name], "The account could not be removed")
    return []


def op_timezone(args):
    (zone,) = args
    if not ZONE_RE.match(zone) or ".." in zone:
        raise Refused("'%s' is not a time zone." % zone)
    path = os.path.realpath(os.path.join(ZONEINFO, zone))
    if not path.startswith(os.path.realpath(ZONEINFO) + os.sep) or not os.path.isfile(path):
        raise Refused("'%s' is not a time zone." % zone)
    must(["timedatectl", "set-timezone", zone], "The time zone could not be changed")
    # a zone chosen by hand: no longer set automatically (sg-timezone-auto)
    write_tz_auto("off")
    # Debian's record of the zone by name, which the Control Panel reads back
    tzfile = "/etc/timezone" if not TEST else os.environ.get("SG_ADMIN_TIMEZONE", "/dev/null")
    try:
        with open(tzfile + ".sg-new", "w") as f:
            f.write(zone + "\n")
        os.chmod(tzfile + ".sg-new", 0o644)
        os.replace(tzfile + ".sg-new", tzfile)
    except OSError as e:
        log("%s not updated: %s" % (tzfile, e))
    return []


TZ_AUTO = os.environ.get("SG_ADMIN_TZ_AUTO", "/etc/stained-glass/timezone-auto")


def write_tz_auto(value):
    try:
        os.makedirs(os.path.dirname(TZ_AUTO), exist_ok=True)
        with open(TZ_AUTO + ".sg-new", "w") as f:
            f.write(value + "\n")
        os.chmod(TZ_AUTO + ".sg-new", 0o644)
        os.replace(TZ_AUTO + ".sg-new", TZ_AUTO)
    except OSError as e:
        log("%s not updated: %s" % (TZ_AUTO, e))


def op_timezone_auto(args):
    """Set time zone automatically, on or off (Settings > Date & time)"""
    (v,) = args
    if v not in ("on", "off"):
        raise Refused("Setting the time zone automatically is on or off.")
    write_tz_auto(v)
    if v == "on" and not TEST:
        subprocess.run(["systemctl", "start", "--no-block", "sg-timezone-auto.service"], check=False)
    return []


LOGIND_DROPIN = os.environ.get("SG_ADMIN_LOGIND_DROPIN", "/etc/systemd/logind.conf.d/60-stained-glass-power.conf")
POWER_ACTIONS = ("ignore", "lock", "suspend", "hibernate", "poweroff")


def op_power_buttons(args):
    """What the power button and closing the lid do (Settings > Power & sleep,
    Control Panel's Power Options; David 2026-10-03): systemd-logind's, for
    the whole machine -- the lid on battery, the lid plugged in, the power
    button -- as a drop-in of our own, which logind reads again at once."""
    lid, lid_ac, power = args
    for v in (lid, lid_ac, power):
        if v not in POWER_ACTIONS:
            raise Refused("A power action is one of: " + ", ".join(POWER_ACTIONS) + ".")
    os.makedirs(os.path.dirname(LOGIND_DROPIN), exist_ok=True)
    body = ("# Stained Glass OS: Settings > Power & sleep (sg-admind power-buttons).\n"
            "[Login]\nHandleLidSwitch=%s\nHandleLidSwitchExternalPower=%s\nHandlePowerKey=%s\n" % (lid, lid_ac, power))
    tmp = LOGIND_DROPIN + ".new"
    with open(tmp, "w") as f:
        f.write(body)
    os.chmod(tmp, 0o644)
    os.replace(tmp, LOGIND_DROPIN)
    if not TEST:
        subprocess.run(["systemctl", "kill", "-s", "HUP", "systemd-logind"], check=False)
    return []


DEFENDER_CONF = os.environ.get("SG_ADMIN_DEFENDER_CONF", "/etc/stained-glass/defender.conf")


def op_defender(args):
    """SG Defender, on or off (Settings > Virus & threat protection): its
    setting for sg-defender, and ClamAV's daemons with it -- off gives back
    the memory its definitions hold."""
    (v,) = args
    if v not in ("on", "off"):
        raise Refused("Virus & threat protection is on or off.")
    try:
        os.makedirs(os.path.dirname(DEFENDER_CONF), exist_ok=True)
        with open(DEFENDER_CONF + ".sg-new", "w") as f:
            f.write("# SG Defender: scan downloaded programs (Settings > Virus & threat protection)\n"
                    "enabled=%d\n" % (v == "on"))
        os.chmod(DEFENDER_CONF + ".sg-new", 0o644)
        os.replace(DEFENDER_CONF + ".sg-new", DEFENDER_CONF)
    except OSError as e:
        raise Refused("The setting could not be saved: %s" % e)
    if not TEST:
        units = ["clamav-daemon.service", "clamav-freshclam.service"]
        subprocess.run(["systemctl", "enable" if v == "on" else "disable", "--now", "--no-block"] + units,
                       capture_output=True, check=False)
        subprocess.run(["systemctl", "restart", "--no-block", "sg-defender.service"], capture_output=True,
                       check=False)
    return []


DEFENDER_STATE = os.environ.get("SG_ADMIN_DEFENDER_STATE", "/var/lib/stained-glass/defender")
QUARANTINE_ID = re.compile(r"\d{8}-\d{6}-[0-9a-f]{6}")


def quarantined(qid):
    """a quarantined file's record (sg-defender's quarantine/<id>.json)"""
    if not QUARANTINE_ID.fullmatch(qid):
        raise Refused("That is not a quarantined file.")
    import json
    try:
        with open(os.path.join(DEFENDER_STATE, "quarantine", qid + ".json")) as f:
            return json.load(f)
    except (OSError, ValueError):
        raise Refused("That file is no longer in quarantine.")


def forget_quarantined(qid, meta):
    for name in (qid + ".bin", qid + ".json"):
        try:
            os.unlink(os.path.join(DEFENDER_STATE, "quarantine", name))
        except FileNotFoundError:
            pass
    try:
        os.unlink(os.path.join(DEFENDER_STATE, "notices", str(int(meta.get("uid", -1))), qid + ".json"))
    except (FileNotFoundError, ValueError):
        pass


def write_as(uid, path, data, mode):
    """Create PATH (not an existing one) holding DATA, as UID: the folder is
    theirs, so root writing there could be led elsewhere by a link they
    planted. Returns the name used: "x (restored).exe" if x.exe is taken."""
    import pwd
    r, w = os.pipe()
    pid = os.fork()
    if pid == 0:
        try:
            os.close(r)
            if not TEST:
                pw = pwd.getpwuid(uid)
                os.setgroups([])
                os.setgid(pw.pw_gid)
                os.setuid(uid)
            base, ext = os.path.splitext(path)
            for n in range(0, 20):
                cand = path if n == 0 else "%s (restored%s)%s" % (base, "" if n == 1 else " %d" % n, ext)
                try:
                    fd = os.open(cand, os.O_WRONLY | os.O_CREAT | os.O_EXCL | os.O_NOFOLLOW, mode)
                except FileExistsError:
                    continue
                with os.fdopen(fd, "wb") as f:
                    f.write(data)
                os.write(w, cand.encode())
                os._exit(0)
            os._exit(2)
        except BaseException:
            os._exit(1)
    os.close(w)
    with os.fdopen(r, "rb") as f:
        name = f.read().decode(errors="replace")
    _, status = os.waitpid(pid, 0)
    if not os.WIFEXITED(status) or os.WEXITSTATUS(status) != 0 or not name:
        raise Refused("The file could not be put back in %s." % os.path.dirname(path))
    return name


def op_defender_restore(args):
    """Restore a quarantined file where it was, as its owner's (Settings >
    Virus & threat protection > Restore), and let that exact file be from
    now on: its SHA-256 joins sg-defender's allowed list."""
    (qid,) = args
    meta = quarantined(qid)
    with open(os.path.join(DEFENDER_STATE, "quarantine", qid + ".bin"), "rb") as f:
        data = f.read()
    import hashlib
    digest = hashlib.sha256(data).hexdigest()
    if digest != meta.get("sha256", digest):
        raise Refused("The quarantined file is not the one that was quarantined.")
    allowed = os.path.join(DEFENDER_STATE, "allowed")
    with open(allowed, "a") as f:     # first: the restored file must not be caught again
        f.write("%s %s\n" % (digest, os.path.basename(meta["path"])))
    os.chmod(allowed, 0o644)
    name = write_as(int(meta["uid"]), meta["path"], data, int(meta.get("mode", 0o644)) & 0o755)
    forget_quarantined(qid, meta)
    log("restored %s (%s) to %s" % (qid, meta.get("signature"), name))
    return [name]


