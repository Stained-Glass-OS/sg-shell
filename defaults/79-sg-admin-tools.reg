Windows Registry Editor Version 5.00

; Stained Glass OS -- the administrative tools (sg-mmc, sg-shell). wine-sg 0142
; puts mmc.exe, eventvwr.exe, resmon.exe and cleanmgr.exe in system32 as
; launchers for these App Paths entries, hands msinfo32.exe off the same way,
; writes services.msc, eventvwr.msc, devmgmt.msc, diskmgmt.msc and
; compmgmt.msc, and opens .msc files with mmc.exe -- so the Run box, cmd,
; scripts, Win+X, the Start menu's Administrative Tools and the Control
; Panel's all reach these.
;
; The paths are the package's install location reached through Z:. If Z: is
; ever removed from the prefix for isolation, this must move with it.

[HKEY_LOCAL_MACHINE\Software\Microsoft\Windows\CurrentVersion\App Paths\mmc.exe]
@="Z:\\usr\\libexec\\stained-glass\\shell\\sg-mmc64.exe"

; Event Viewer: the same console host under its own name (App Paths values
; cannot carry arguments), so eventvwr.exe opens Event Viewer.
[HKEY_LOCAL_MACHINE\Software\Microsoft\Windows\CurrentVersion\App Paths\eventvwr.exe]
@="Z:\\usr\\libexec\\stained-glass\\shell\\sg-eventvwr64.exe"

; System Information: the console host under its own name. Wine's own
; system32\msinfo32.exe hands off to this entry (wine-sg 0142).
[HKEY_LOCAL_MACHINE\Software\Microsoft\Windows\CurrentVersion\App Paths\msinfo32.exe]
@="Z:\\usr\\libexec\\stained-glass\\shell\\sg-msinfo3264.exe"

; Disk Cleanup: cleanmgr.exe (wine-sg 0142's launcher) opens this.
[HKEY_LOCAL_MACHINE\Software\Microsoft\Windows\CurrentVersion\App Paths\cleanmgr.exe]
@="Z:\\usr\\libexec\\stained-glass\\shell\\sg-cleanmgr64.exe"

; Resource Monitor: resmon.exe (wine-sg 0142's launcher) opens this.
[HKEY_LOCAL_MACHINE\Software\Microsoft\Windows\CurrentVersion\App Paths\resmon.exe]
@="Z:\\usr\\libexec\\stained-glass\\shell\\sg-resmon64.exe"
