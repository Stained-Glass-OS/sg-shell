Windows Registry Editor Version 5.00

; Stained Glass OS -- SG Store (sg-store): the application store.
;
; A catalogue of applications the OS can install on demand. For any app the
; Windows (wine-sg) build is the ideal path and the default suggestion; our own
; builds (SG Office) sit beside them; native Linux desktop apps (Tier=linux)
; are listed last, in SG Store's "Linux apps" section, and installed with apt
; through the administrator's consent and sg-admind (apt-install).
;
; We ship no third-party or Microsoft binary: SG Store downloads the maker's
; installer at the user's request and runs it only if it is exactly the file
; the maker published -- a pinned SHA-256, or the winget community repository's,
; the same engine as "Get a web browser". Our own builds (SG Office) are our
; apt packages, installed with apt like the Linux apps and registered in the
; Windows side as they install. See ADR 0017.
;
; OS updates are NOT handled here: they keep their own path (Settings >
; Update & Security). SG Store never touches the system upgrade.
;
; Each app is Apps\NN with:
;   Name, Publisher, Description, Category, Colour (0x00RRGGBB letter badge),
;   Tier   = windows | ours | linux         (inferred from Source if absent)
;   Source = winget:<PackageId>
;          | pin:<Url>|<Sha256>|<Type>|<Silent>   (Type: msi, nullsoft, inno, burn, exe,
;            or iexpress-msi -- a package of MSIs, unpacked and installed x86 first)
;          | ours:apt:<package> | linux:apt:<package>   (apt, via sg-admind)
;   DetectName = a Windows program's Uninstall DisplayName: "A|B|!C" -- the
;                name starts with A or B as a whole word ("Git" is not "GitHub
;                Desktop"), and not with C ("XnView|!XnView MP"); * is any run of
;                characters ("Mozilla Firefox*ESR"). A Linux app, or one of
;                ours, is detected by dpkg's state of its package, never by name.
;   Run        = what Open starts: a Linux app's program, e.g. /usr/bin/gimp;
;                one of ours, its Windows program's App Paths name
;   PinVersion = the available version for a pin: entry (update checks)
;   Icon       = its picture: https: (Flathub's appstream icon, else the
;                maker's site's) or a file; fetched when SG Store first shows
;                it and cached per person -- we ship no maker's artwork
;   Linux      = (a Windows program) the ordinal of the same app's Linux
;                build: the pair is one card, with a choice of build
;   Prefer     = windows: suggest the Windows build of the pair; otherwise
;                the Linux build is suggested (native, no Wine in between)
;
; Every winget: id here exists in github.com/microsoft/winget-pkgs (checked
; 2026-09-30, each resolving to an installer SG Store can run). FileZilla is
; not in that repository, so it is offered as a Linux app only.
;
; A mirror or Group Policy may later replace the whole catalogue via
; HKLM\Software\Stained Glass\Store CatalogUrl. The winget source is the same
; ListUrl/RawUrl as Web Browsers (SG_BROWSER_LIST_URL / RawUrl for the gate).

[HKEY_LOCAL_MACHINE\Software\Microsoft\Windows\CurrentVersion\App Paths\sg-store.exe]
@="Z:\\usr\\libexec\\stained-glass\\shell\\sg-store64.exe"

[HKEY_LOCAL_MACHINE\Software\Microsoft\Windows\CurrentVersion\App Paths\sgstore.exe]
@="Z:\\usr\\libexec\\stained-glass\\shell\\sg-store64.exe"

[HKEY_LOCAL_MACHINE\Software\Classes\Applications\sg-store64.exe]
"FriendlyAppName"="SG Store"

[HKEY_LOCAL_MACHINE\Software\Classes\Applications\sg-store64.exe\shell\open\command]
@="\"Z:\\usr\\libexec\\stained-glass\\shell\\sg-store64.exe\""

; ---- Linux software packages (.deb): double-click installs ------------------------------
; "Install a Linux package" (sg-store64.exe --deb): what the package is (name,
; version, who made it), then apt installs it with its dependencies after an
; administrator's consent -- e.g. Valve's steam.deb.

[HKEY_LOCAL_MACHINE\Software\Classes\.deb]
@="SG.LinuxPackage"
"Content Type"="application/vnd.debian.binary-package"
"PerceivedType"="application"

[HKEY_LOCAL_MACHINE\Software\Classes\SG.LinuxPackage]
@="Linux software package"
"FriendlyTypeName"="Linux software package"

[HKEY_LOCAL_MACHINE\Software\Classes\SG.LinuxPackage\DefaultIcon]
@="Z:\\usr\\libexec\\stained-glass\\shell\\sg-store64.exe,0"

[HKEY_LOCAL_MACHINE\Software\Classes\SG.LinuxPackage\shell]
@="open"

[HKEY_LOCAL_MACHINE\Software\Classes\SG.LinuxPackage\shell\open]
@="&Install"

[HKEY_LOCAL_MACHINE\Software\Classes\SG.LinuxPackage\shell\open\command]
@="\"Z:\\usr\\libexec\\stained-glass\\shell\\sg-store64.exe\" --deb \"%1\""

; ---- the catalogue --------------------------------------------------------------------
; Replaced whole on each import, so an app taken out of the list goes.

[-HKEY_LOCAL_MACHINE\Software\Stained Glass\Store\Apps]

