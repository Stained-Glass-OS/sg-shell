Windows Registry Editor Version 5.00

; Stained Glass OS: a Linux app's .desktop file (Steam puts one on the desktop
; at its first start) opens the app, through sg-linuxapp64.exe (gio launch),
; and shows by its name alone, as a shortcut does. Start lists the installed
; ones itself (Programs\Linux apps, src/linuxapps).

[HKEY_LOCAL_MACHINE\Software\Classes\.desktop]
@="SG.LinuxApp"
"PerceivedType"="application"

[HKEY_LOCAL_MACHINE\Software\Classes\SG.LinuxApp]
@="Linux app"
"FriendlyTypeName"="Linux app"
"NeverShowExt"=""

[HKEY_LOCAL_MACHINE\Software\Classes\SG.LinuxApp\DefaultIcon]
@="Z:\\usr\\libexec\\stained-glass\\shell\\sg-store64.exe,0"

; each file's own icon, the app's (sglinuxicon64.dll; the icon above when
; it has none made)
[HKEY_LOCAL_MACHINE\Software\Classes\SG.LinuxApp\shellex\IconHandler]
@="{0FADADA1-718E-488D-A815-66A920A012EF}"

[HKEY_LOCAL_MACHINE\Software\Classes\CLSID\{0FADADA1-718E-488D-A815-66A920A012EF}]
@="Stained Glass Linux app icon"

[HKEY_LOCAL_MACHINE\Software\Classes\CLSID\{0FADADA1-718E-488D-A815-66A920A012EF}\InprocServer32]
@="Z:\\usr\\libexec\\stained-glass\\shell\\sglinuxicon64.dll"
"ThreadingModel"="Apartment"

[HKEY_LOCAL_MACHINE\Software\Classes\SG.LinuxApp\shell]
@="open"

[HKEY_LOCAL_MACHINE\Software\Classes\SG.LinuxApp\shell\open\command]
@="\"Z:\\usr\\libexec\\stained-glass\\shell\\sg-linuxapp64.exe\" --run \"%1\""

; An AppImage (Foo-x86_64.AppImage: a Linux program in one file) someone
; downloaded: double-click (or right-click > Install) shows what it is and
; installs it for the user alone -- ~/Applications and Start (sg-store64.exe
; --appimage, sg-appimage). Nothing runs until it is started from Start.

[HKEY_LOCAL_MACHINE\Software\Classes\.AppImage]
@="SG.AppImage"
"Content Type"="application/vnd.appimage"
"PerceivedType"="application"

[HKEY_LOCAL_MACHINE\Software\Classes\SG.AppImage]
@="AppImage (Linux program)"
"FriendlyTypeName"="AppImage (Linux program)"

[HKEY_LOCAL_MACHINE\Software\Classes\SG.AppImage\DefaultIcon]
@="Z:\\usr\\libexec\\stained-glass\\shell\\sg-store64.exe,0"

[HKEY_LOCAL_MACHINE\Software\Classes\SG.AppImage\shell]
@="open"

[HKEY_LOCAL_MACHINE\Software\Classes\SG.AppImage\shell\open]
@="&Install"

[HKEY_LOCAL_MACHINE\Software\Classes\SG.AppImage\shell\open\command]
@="\"Z:\\usr\\libexec\\stained-glass\\shell\\sg-store64.exe\" --appimage \"%1\""
