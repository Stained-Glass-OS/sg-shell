#!/usr/bin/make -f
export DEB_BUILD_OPTIONS ?= nocheck
%:
	dh $@

override_dh_auto_build:
	$(MAKE) build

override_dh_auto_test:

override_dh_auto_install:
	install -d debian/sg-shell/usr/libexec/stained-glass/shell
	install -m0755 build/sg-start64.exe build/sg-start32.exe \
	    build/sg-mstsc64.exe build/sg-mstsc32.exe \
	    build/sg-control64.exe build/sg-control32.exe build/sg-settings64.exe build/sg-terminal64.exe build/sg-clock64.exe \
	    build/sg-gpresult64.exe build/sg-gpresult32.exe \
	    build/sg-ncpa64.exe build/sg-netflyout64.exe build/sg-battery64.exe build/sg-defender-notice64.exe build/sg-restart-notice64.exe build/sg-kiosk64.exe build/sg-volume64.exe build/sg-notify64.exe build/sg-dictate64.exe build/sg-zip64.exe \
	    build/sg-media64.exe \
	    build/sg-calc64.exe \
	    build/sg-photos64.exe \
	    build/sg-taskmgr64.exe \
	    build/sg-paint64.exe \
	    build/sg-sticky64.exe \
	    build/sg-snip64.exe \
	    build/sg-charmap64.exe \
	    build/sg-rootterm64.exe src/rootterm/sg-root-terminal src/rootterm/sg-linux-terminal src/sg-rdp-connect \
	    build/sg-linuxapp64.exe \
	    build/sg-bugreport64.exe src/bugreport/sg-bugreport-info src/bugreport/sg-debug-run src/bugreport/sg-debug-summary src/bugreport/sg-bugreport-send \
	    build/sg-wordpad64.exe \
	    build/sg-fontview64.exe \
	    build/sgcompat64.dll \
	    build/sglinuxicon64.dll \
	    build/sg-magnify64.exe build/sg-osk64.exe build/sg-touchkbd64.exe \
	    build/sg-browser64.exe \
	    build/sg-store64.exe src/store/sg-debinfo src/store/sg-appinfo \
	    build/sg-mmc64.exe build/sg-eventvwr64.exe build/sg-msinfo3264.exe build/sg-cleanmgr64.exe build/sg-resmon64.exe \
	    debian/sg-shell/usr/libexec/stained-glass/shell/
	# The Control Panel's privileged half: a fixed list of administrative
	# operations for requests from SYSTEM (see admin/sg-admind).
	install -D -m0755 admin/sg-admind debian/sg-shell/usr/libexec/stained-glass/sg-admind
	install -D -m0644 admin/apt-vendors/steam-stable.list debian/sg-shell/usr/share/stained-glass/apt-vendors/steam-stable.list
	install -D -m0644 admin/apt-vendors/steam.gpg debian/sg-shell/usr/share/stained-glass/apt-vendors/steam.gpg
	install -D -m0644 admin/apt-vendors/google-chrome.sources debian/sg-shell/usr/share/stained-glass/apt-vendors/google-chrome.sources
	install -D -m0644 admin/apt-vendors/google-chrome.gpg debian/sg-shell/usr/share/stained-glass/apt-vendors/google-chrome.gpg
	install -D -m0644 admin/apt-vendors/microsoft-edge.list debian/sg-shell/usr/share/stained-glass/apt-vendors/microsoft-edge.list
	install -D -m0644 admin/apt-vendors/microsoft-edge.gpg debian/sg-shell/usr/share/stained-glass/apt-vendors/microsoft-edge.gpg
	install -D -m0644 admin/apt-vendors/mozilla.list debian/sg-shell/usr/share/stained-glass/apt-vendors/mozilla.list
	install -D -m0644 admin/apt-vendors/packages.mozilla.org.asc debian/sg-shell/usr/share/stained-glass/apt-vendors/packages.mozilla.org.asc
	install -D -m0644 admin/apt-vendors/mozilla.pref debian/sg-shell/usr/share/stained-glass/apt-vendors/mozilla.pref
	install -D -m0644 admin/sg-admind.service debian/sg-shell/usr/lib/systemd/system/sg-admind.service
	install -D -m0644 admin/sg-admind.path debian/sg-shell/usr/lib/systemd/system/sg-admind.path
	install -D -m0644 admin/sg-admind.tmpfiles debian/sg-shell/usr/lib/tmpfiles.d/sg-admind.conf
	# Set time zone automatically (Settings > Date & time): at boot and every
	# six hours, while it is on
	install -D -m0755 admin/sg-timezone-auto debian/sg-shell/usr/libexec/stained-glass/sg-timezone-auto
	install -D -m0644 admin/sg-timezone-auto.service debian/sg-shell/usr/lib/systemd/system/sg-timezone-auto.service
	install -D -m0644 admin/sg-timezone-auto.timer debian/sg-shell/usr/lib/systemd/system/sg-timezone-auto.timer
	install -D -m0755 admin/sg-timezone-auto.nm-dispatcher debian/sg-shell/usr/lib/NetworkManager/dispatcher.d/90-sg-timezone-auto
	# Window colours and other registry defaults: sg-prefix-init imports these
	# into every new prefix's Default User profile.
	# Wallpapers: our own art, generated here (theme/wallpapers).
	install -d debian/sg-shell/usr/share/stained-glass/wallpapers
	python3 theme/wallpapers/gen-wallpaper.py debian/sg-shell/usr/share/stained-glass/wallpapers/stained-glass.jpg
	python3 theme/wallpapers/gen-wallpaper.py --night debian/sg-shell/usr/share/stained-glass/wallpapers/stained-glass-night.jpg
	install -d debian/sg-shell/usr/share/stained-glass/defaults.d
	# what sg-compositor shows where no window is (its backdrop.c)
	python3 theme/gen-backdrop.py debian/sg-shell/usr/share/stained-glass/backdrop.sgbd
	python3 theme/gen-backdrop.py --first debian/sg-shell/usr/share/stained-glass/backdrop-first.sgbd
	install -m0644 theme/*.reg $(filter-out defaults/80-sg-pdf.reg,$(wildcard defaults/*.reg)) \
	    debian/sg-shell/usr/share/stained-glass/defaults.d/
	# Linux apps Start does not list: the system's own plumbing (src/linuxapps)
	install -m0644 src/linuxapps/linux-apps-hidden debian/sg-shell/usr/share/stained-glass/linux-apps-hidden
	install -D -m0755 src/linuxapps/sg-linuxapp-deps debian/sg-shell/usr/libexec/stained-glass/sg-linuxapp-deps
	# AppImages a person downloaded, installed for them (src/linuxapps/sg-appimage)
	install -D -m0755 src/linuxapps/sg-appimage debian/sg-shell/usr/libexec/stained-glass/sg-appimage
	# The shell's icon font (caption buttons of Windows 10/11-era programs):
	# drawn by src/sg-icons-font.py; theme/52-sg-fonts.reg maps names to it.
	install -d debian/sg-shell/usr/share/fonts/truetype/stained-glass
	python3 src/sg-icons-font.py debian/sg-shell/usr/share/fonts/truetype/stained-glass/StainedGlassIcons.ttf
	# SG Office (package sg-office): its three programs, which start SG
	# Office's editors (package sg-office-editors), and its registrations (office/).
	install -d debian/sg-office/usr/libexec/stained-glass/shell debian/sg-office/usr/share/stained-glass/defaults.d
	install -m0755 build/sg-documents64.exe build/sg-spreadsheets64.exe build/sg-presentations64.exe \
	    debian/sg-office/usr/libexec/stained-glass/shell/
	install -m0644 office/defaults/*.reg debian/sg-office/usr/share/stained-glass/defaults.d/
	# the programs' icons as image files too (SG Store's card, Linux menus):
	# /usr/share/icons/hicolor/<size>/apps/sg-office-<kind>.png
	for d in build/office/icons/png/*; do \
	    install -d debian/sg-office/usr/share/icons/hicolor/$$(basename $$d)/apps; \
	    install -m0644 $$d/apps/sg-office-*.png debian/sg-office/usr/share/icons/hicolor/$$(basename $$d)/apps/; done
	# SG PDF (package sg-pdf): the program, its registrations (the .pdf
	# association), its icons and the Linux programs' PDF handler
	install -D -m0755 build/sg-pdf64.exe debian/sg-pdf/usr/libexec/stained-glass/shell/sg-pdf64.exe
	install -D -m0644 defaults/80-sg-pdf.reg debian/sg-pdf/usr/share/stained-glass/defaults.d/80-sg-pdf.reg
	install -D -m0644 src/pdf/sg-pdf.desktop debian/sg-pdf/usr/share/applications/sg-pdf.desktop
	for d in build/pdf-icons/*; do \
	    install -D -m0644 $$d/apps/sg-pdf.png debian/sg-pdf/usr/share/icons/hicolor/$$(basename $$d)/apps/sg-pdf.png; done
	# Recommended per-program settings for the Compatibility tab (src/compat).
	install -D -m0644 data/compat-presets.ini debian/sg-shell/usr/share/stained-glass/compat-presets.ini
